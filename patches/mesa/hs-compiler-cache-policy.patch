diff --git a/src/util/hs_compiler_options.h b/src/util/hs_compiler_options.h
new file mode 100644
--- /dev/null
+++ b/src/util/hs_compiler_options.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: MIT
+ * Copyright 2026 Open-Ocarina contributors
+ *
+ * Cache identity for the private HS compiler policy. This conservatively
+ * distinguishes raw startup option spelling as well as presence. Compiler
+ * options must be fixed before Mesa initialization and remain immutable for
+ * the process lifetime: existing compiler readers cache several getenv values.
+ */
+#ifndef HS_COMPILER_OPTIONS_H
+#define HS_COMPILER_OPTIONS_H
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include "util/mesa-blake3.h"
+
+static inline void
+hs_compiler_key_u64(struct mesa_blake3 *ctx, uint64_t value)
+{
+   uint8_t encoded[8];
+   for (unsigned i = 0; i < sizeof(encoded); i++)
+      encoded[i] = value >> (8 * i);
+   _mesa_blake3_update(ctx, encoded, sizeof(encoded));
+}
+
+/* scope is a Vulkan shader-stage mask, or zero for device-wide identity.
+ * Every option is encoded in every scope. Do not add stage-specific omissions.
+ */
+static inline void
+hs_compiler_options_blake3_update(struct mesa_blake3 *ctx, uint32_t scope)
+{
+   static const char domain[] = "anv-hs-compiler-policy-v1";
+   static const char *const names[] = {
+      "HS_FORCE_SIMD8",
+      "HS_CS32_MAX_INSTS",
+      "HS_SPILL_BATCH",
+      "HS_SPILL_PCT",
+      "HS_LARGE_GRF",
+      "HS_SUBGROUP8",
+      "shader_spilling_rate",
+   };
+
+   _mesa_blake3_update(ctx, domain, sizeof(domain));
+   hs_compiler_key_u64(ctx, scope);
+   hs_compiler_key_u64(ctx, sizeof(names) / sizeof(names[0]));
+   for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+      const char *value = getenv(names[i]);
+      const uint8_t present = value != NULL;
+      const uint64_t size = present ? strlen(value) : 0;
+      hs_compiler_key_u64(ctx, strlen(names[i]));
+      _mesa_blake3_update(ctx, names[i], strlen(names[i]));
+      _mesa_blake3_update(ctx, &present, sizeof(present));
+      hs_compiler_key_u64(ctx, size);
+      if (present)
+         _mesa_blake3_update(ctx, value, size);
+   }
+}
+
+/* The effective drirc value may differ even when getenv spelling is identical.
+ * Include it, and Mesa's existing compiler debug/SIMD configuration, in ANV
+ * state, UUIDs and the disk-cache namespace as well as the raw startup policy.
+ */
+static inline void
+hs_compiler_effective_blake3_update(struct mesa_blake3 *ctx,
+                                   uint64_t compiler_config,
+                                   int32_t spilling_rate)
+{
+   static const char domain[] = "anv-hs-effective-policy-v1";
+   _mesa_blake3_update(ctx, domain, sizeof(domain));
+   hs_compiler_key_u64(ctx, compiler_config);
+   hs_compiler_key_u64(ctx, (uint32_t)spilling_rate);
+}
+
+#endif /* HS_COMPILER_OPTIONS_H */
