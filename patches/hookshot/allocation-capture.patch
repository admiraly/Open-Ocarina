+struct OoAllocationPending {
+    bool active=false,after_recorded=false,copies=false;
+    VkCommandBuffer command=VK_NULL_HANDLE;
+    uint64_t candidate_bytes=0;
+    std::vector<oo_alloc::Row> rows;
+    std::vector<oo_alloc::Descriptor> descriptors;
+    std::vector<std::string> failures;
+    std::vector<OoAllocationCopy> copies_by_row;
+};
