+    source.dstStageMask=VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;source.dstAccessMask=VK_ACCESS_2_MEMORY_READ_BIT|VK_ACCESS_2_MEMORY_WRITE_BIT;
