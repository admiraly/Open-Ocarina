+// Open-Ocarina: one conservative pool catalog, GPU payloads at the selected dispatch's boundaries.
+namespace {
+struct OoAllocationCopy {
+    VkBuffer before=VK_NULL_HANDLE,after=VK_NULL_HANDLE;
+    VmaAllocation before_alloc=nullptr,after_alloc=nullptr;
+    void* before_map=nullptr;void* after_map=nullptr;
