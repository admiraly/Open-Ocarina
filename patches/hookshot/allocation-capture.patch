+void memory_allocation_descriptors(VkCommandBuffer cmd,const std::vector<VkWriteDescriptorSet>& writes) {
+    if(!oo_alloc::config().enabled)return;
+    std::lock_guard lock(oo_page_mutex);auto& state=oo_alloc_pending;
+    if(oo_page_pending.attempted)return;
+    state.command=cmd;state.descriptors.clear();
+    for(const auto& write:writes) {
+        if(!write.pBufferInfo)continue;
+        for(uint32_t i=0;i<write.descriptorCount;++i) {
+            const auto& info=write.pBufferInfo[i];
+            state.descriptors.push_back({write.dstBinding,write.dstArrayElement+i,(uint32_t)write.descriptorType,
+                                         (uint64_t)(uintptr_t)info.buffer,info.offset,info.range});
+        }
+    }
+}
+void oo_allocation_record(VkCommandBuffer cmd) { // oo_page_mutex held; no CPU guest payload read.
+    if(!oo_alloc::config().enabled)return;
+    auto& state=oo_alloc_pending;state.active=true;state.command=cmd;
+    state.failures={"images_not_captured","temporal_state_not_captured","underlying_import_aliases_unresolved","cpu_writers_not_quiesced"};
+    std::lock_guard pool_lock(pools_mu);
+    auto add=[&](VkBuffer buffer,VmaAllocation alloc,VkDeviceMemory memory,uint64_t lo,uint64_t hi,
+                 uint64_t usage,const std::vector<VkDeviceMemory>& pieces,const char* role) {
+        if(!buffer)return;
+        if(std::any_of(state.rows.begin(),state.rows.end(),[&](const auto& r){return r.buffer==(uint64_t)(uintptr_t)buffer;}))return;
+        if(state.rows.size()>=16384){state.failures.push_back("catalog_entry_limit_exceeded");return;}
+        oo_alloc::Row row;row.buffer=(uint64_t)(uintptr_t)buffer;row.size=hi-lo;row.guest_lo=lo;row.guest_hi=hi;
+        row.role=role;row.usage=usage;row.memory=(uint64_t)(uintptr_t)memory;
+        VkBufferDeviceAddressInfo address{VK_STRUCTURE_TYPE_BUFFER_DEVICE_ADDRESS_INFO};address.buffer=buffer;
+        row.address=vkGetBufferDeviceAddress(dev.device,&address);
+        if(alloc){VmaAllocationInfo info{};vmaGetAllocationInfo(vma,alloc,&info);row.memory=(uint64_t)(uintptr_t)info.deviceMemory;row.memory_offset=info.offset;}
+        if(row.memory)row.memory_pieces.push_back(row.memory);
+        for(auto piece:pieces)row.memory_pieces.push_back((uint64_t)(uintptr_t)piece);
+        row.piece_count=row.memory_pieces.size();
+        row.copy_supported=(usage&VK_BUFFER_USAGE_TRANSFER_SRC_BIT)&&row.size&&row.size%4==0;
+        if(!row.address)state.failures.push_back("buffer_device_address_missing");
+        if(!pieces.empty())state.failures.push_back("sparse_memory_piece_identity_unresolved");
+        if(!row.copy_supported)state.failures.push_back("source_usage_or_copy_alignment_unsupported");
+        if(row.size>UINT64_MAX-state.candidate_bytes){state.failures.push_back("candidate_bytes_overflow");row.copy_supported=false;}
+        else state.candidate_bytes+=row.size;
+        state.rows.push_back(row);
+    };
+    auto pool=[&](const Pool& p,const char* role) {
+        add(p.buffer,nullptr,p.memory,p.lo,p.hi,kUsage,p.pieces,role);
+        add(p.mirror,p.mirror_alloc,VK_NULL_HANDLE,p.lo,p.hi,kUsage,{},"pool-mirror");
+        add(p.shadow,p.shadow_alloc,VK_NULL_HANDLE,p.lo,p.hi,VK_BUFFER_USAGE_TRANSFER_SRC_BIT|VK_BUFFER_USAGE_TRANSFER_DST_BIT|
+            VK_BUFFER_USAGE_STORAGE_BUFFER_BIT|VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT,{},"writeback-shadow");
+    };
+    for(const auto& item:imported)pool(item.second,"live-import");
+    for(const auto& node:retired_pools)pool(node.mapped(),"retired-import");
+    for(const auto& node:evicted_pools)pool(node.mapped(),"evicted-import");
+    for(const auto& item:dead_imports)add(item.buffer,nullptr,item.memory,item.lo,item.hi,kUsage,item.pieces,"queued-import");
+    for(const auto& item:dead_mirrors)add(item.buffer,item.alloc,VK_NULL_HANDLE,item.lo,item.hi,kUsage,{},"queued-mirror");
+    for(const auto& item:dead_shadows)add(item.buffer,item.alloc,VK_NULL_HANDLE,item.lo,item.hi,
+        VK_BUFFER_USAGE_TRANSFER_SRC_BIT|VK_BUFFER_USAGE_TRANSFER_DST_BIT|VK_BUFFER_USAGE_STORAGE_BUFFER_BIT|
+        VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT,{},"queued-shadow");
+    {std::lock_guard background_lock(bg_mu);if(!bg_ready.empty()||!bg_inflight.empty())state.failures.push_back("background_imports_not_cataloged");}
+    // Capturing early cannot prove that later recording work creates no new source. The copied GPU table is checked after completion.
+    state.failures.push_back("late_allocations_require_completed_table_resolution");
+    for(const auto& descriptor:state.descriptors) {
+        auto it=std::find_if(state.rows.begin(),state.rows.end(),[&](const auto& row){return row.buffer==descriptor.buffer;});
+        if(it==state.rows.end())state.failures.push_back("descriptor_owner_unknown");
+        else if(descriptor.offset>=it->size||(descriptor.range!=VK_WHOLE_SIZE&&descriptor.range>it->size-descriptor.offset))
+            state.failures.push_back("descriptor_range_unresolved");
+    }
+    logf("vk: Open-Ocarina allocation catalog: %zu candidates, %llu source bytes, %llu required staging bytes, budget %llu (not replay)",
+        state.rows.size(),(unsigned long long)state.candidate_bytes,(unsigned long long)(state.candidate_bytes*2),(unsigned long long)oo_alloc::config().budget);
+    const bool bounded=state.candidate_bytes<=UINT64_MAX/2&&state.candidate_bytes*2<=oo_alloc::config().budget&&
+        std::find(state.failures.begin(),state.failures.end(),"catalog_entry_limit_exceeded")==state.failures.end();
+    if(!bounded){state.failures.push_back("staging_budget_or_catalog_limit_exceeded");return;}
+    state.copies_by_row.resize(state.rows.size());
+    bool made=true;
+    for(size_t i=0;i<state.rows.size();++i) {
+        const auto& row=state.rows[i];auto& copy=state.copies_by_row[i];if(!row.copy_supported)continue;
+        if(!create_buffer_cached(row.size,VK_BUFFER_USAGE_TRANSFER_DST_BIT,copy.before,copy.before_alloc,&copy.before_map,true)||!copy.before_map||
+           !create_buffer_cached(row.size,VK_BUFFER_USAGE_TRANSFER_DST_BIT,copy.after,copy.after_alloc,&copy.after_map,true)||!copy.after_map){made=false;break;}
+    }
+    if(!made) {
+        state.failures.push_back("staging_allocation_failed");
+        for(auto& copy:state.copies_by_row){if(copy.before||copy.before_alloc)destroy_buffer(copy.before,copy.before_alloc);if(copy.after||copy.after_alloc)destroy_buffer(copy.after,copy.after_alloc);}
+        state.copies_by_row.clear();return;
+    }
+    for(const auto& row:state.rows)oo_retained_buffers.insert((VkBuffer)(uintptr_t)row.buffer);
+    state.copies=true;oo_allocation_copy_phase(cmd,false);
+}
+void memory_allocation_after(VkCommandBuffer cmd) {
+    if(!oo_alloc::config().enabled)return;
+    std::lock_guard lock(oo_page_mutex);auto& state=oo_alloc_pending;
+    if(!state.active||state.command!=cmd||state.after_recorded)return;
+    oo_allocation_copy_phase(cmd,true);state.after_recorded=true;
+}
+void oo_allocation_release() { // oo_page_mutex held; cancellation or exact completion only.
+    auto& state=oo_alloc_pending;
+    if(!state.active)return;
+    for(auto& copy:state.copies_by_row){if(copy.before||copy.before_alloc)destroy_buffer(copy.before,copy.before_alloc);if(copy.after||copy.after_alloc)destroy_buffer(copy.after,copy.after_alloc);}
+    {std::lock_guard pool_lock(pools_mu);oo_retained_buffers.clear();}
+    state.copies_by_row.clear();state.active=false;
+}
+void oo_allocation_collect(const oo_pt::Request& request,uint64_t completed,bool table_ok,const uint8_t* table) {
+    auto& state=oo_alloc_pending;if(!state.active)return;
+    bool invalidated=state.copies&&state.after_recorded;
+    try {
+        for(size_t i=0;i<state.copies_by_row.size();++i) {
+            auto& row=state.rows[i];const auto& copy=state.copies_by_row[i];
+            if(!copy.before)continue;
+            const bool before_ok=invalidate_mapped_checked(copy.before_alloc,row.size);
+            const bool after_ok=state.after_recorded&&invalidate_mapped_checked(copy.after_alloc,row.size);
+            invalidated&=before_ok&&after_ok;
+            if(before_ok&&!oo_alloc::save_payload("buffer-"+std::to_string(i)+"-before.bin",static_cast<const uint8_t*>(copy.before_map),row.size,row.before_sha))state.failures.push_back("before_payload_export_failed");
+            if(after_ok&&!oo_alloc::save_payload("buffer-"+std::to_string(i)+"-after.bin",static_cast<const uint8_t*>(copy.after_map),row.size,row.after_sha))state.failures.push_back("after_payload_export_failed");
+        }
+        if(!state.after_recorded)state.failures.push_back("after_dispatch_copy_not_recorded");
+        if(!invalidated)state.failures.push_back("payloads_not_all_invalidated");
+        if(!table_ok)state.failures.push_back("gpu_page_table_export_failed");
+        const auto coverage=table?oo_alloc::table_coverage(table,oo_pt::kTableBytes,state.rows):oo_alloc::TableCoverage{};
+        if(coverage.unresolved)state.failures.push_back("gpu_table_has_unresolved_pages");
+        if(coverage.ambiguous)state.failures.push_back("gpu_table_has_ambiguous_pages");
+        if(coverage.partial)state.failures.push_back("gpu_table_has_partial_pages");
+        if(coverage.missing_payload)state.failures.push_back("gpu_table_has_missing_payloads");
+        std::sort(state.failures.begin(),state.failures.end());state.failures.erase(std::unique(state.failures.begin(),state.failures.end()),state.failures.end());
+        const bool ok=oo_alloc::write_manifest(request,completed,state.rows,state.descriptors,state.failures,state.after_recorded,invalidated,table_ok,coverage,state.candidate_bytes);
+        logf("vk: Open-Ocarina allocation evidence %s: mapped %llu unresolved %llu ambiguous %llu partial %llu missing payload %llu (NOT full replay)",ok?"exported":"failed",
+            (unsigned long long)coverage.mapped,(unsigned long long)coverage.unresolved,(unsigned long long)coverage.ambiguous,(unsigned long long)coverage.partial,(unsigned long long)coverage.missing_payload);
+    }catch(const std::exception& error){logf("vk: Open-Ocarina allocation export failed: %s",error.what());}
+    oo_allocation_release();
+}
