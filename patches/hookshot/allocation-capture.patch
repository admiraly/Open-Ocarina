+// SPDX-License-Identifier: GPL-3.0-or-later
+// Bounded GPU pool payload evidence. Images/aliasing/temporal state still prevent replay.
+#pragma once
+#include "page_table_capture.h"
+#include <algorithm>
+#include <cerrno>
+#include <limits>
+namespace mkwvk::oo_alloc {
+struct Config { bool enabled=false; uint64_t budget=2ull<<30; };
+inline const Config& config() {
+    static const Config c=[] {
+        Config value;
+        const char* enable=std::getenv("RX_VK_OO_ALLOC_CAPTURE");
+        if(!enable||std::string(enable)!="1"||!oo_pt::config().enabled)return value;
+        if(const char* cap=std::getenv("RX_VK_OO_ALLOC_BUDGET_MIB")) {
+            char* end=nullptr;errno=0;const auto n=std::strtoull(cap,&end,10);
+            if(errno||!*cap||*end||n<32||n>8192)return value;
+            value.budget=n<<20;
+        }
+        for(const char* name:{"allocations.json","allocations.json.part"})
+            if(oo_pt::present(std::filesystem::path(oo_pt::config().directory)/name))return value;
+        value.enabled=true;return value;
+    }();return c;
+}
+struct Row {
+    uint64_t buffer=0,address=0,size=0,guest_lo=0,guest_hi=0,memory=0,memory_offset=0;
+    uint64_t usage=0,piece_count=0;
+    std::string role,before_sha,after_sha;
+    std::vector<uint64_t> memory_pieces;
+    bool copy_supported=false;
+};
+struct Descriptor {
+    uint32_t binding=0,element=0,type=0;
+    uint64_t buffer=0,offset=0,range=0;
+};
+inline bool fits(uint64_t used,uint64_t size,uint64_t budget) {
+    return size&&size<=std::numeric_limits<uint64_t>::max()/2&&used<=budget&&size*2<=budget-used;
+}
+// A partial final page is explicit. No alignment assumption about buffer BDA.
+inline uint64_t available(const Row& row,uint64_t address) {
+    return row.address&&address>=row.address&&address-row.address<row.size?row.size-(address-row.address):0;
+}
+inline bool save_payload(const std::string& name,const uint8_t* data,uint64_t size,std::string& digest) {
+    if(!config().enabled||!data||!size||name.find('/')!=std::string::npos)return false;
+    const auto path=std::filesystem::path(oo_pt::config().directory)/name;
+    const auto part=std::filesystem::path(path.string()+".part");
+    if(oo_pt::present(path))return false;
+    FILE* file=std::fopen(part.string().c_str(),"wbx");if(!file)return false;
+    const bool written=std::fwrite(data,1,size,file)==size;
+    const bool closed=std::fclose(file)==0;
+    if(!written||!closed){std::remove(part.string().c_str());return false;}
+    const auto actual_digest=oo_identity::hex(oo_identity::sha256(data,size));
+    std::error_code error;std::filesystem::rename(part,path,error);
+    if(error){std::remove(part.string().c_str());return false;}
+    digest=actual_digest;return true;
+}
+struct TableCoverage { uint64_t mapped=0,unresolved=0,ambiguous=0,partial=0,missing_payload=0; };
+inline TableCoverage table_coverage(const uint8_t* table,size_t bytes,const std::vector<Row>& rows) {
+    TableCoverage result;
+    for(size_t i=0;i<bytes/8;++i) {
+        uint64_t address=0;std::memcpy(&address,table+i*8,8);if(!address)continue;
+        ++result.mapped;size_t hits=0;uint64_t longest=0;bool payload=false;
+        const uint64_t guest=i<(2ull<<20)?0x1000000000ull+i*4096:0x7f00000000ull+(i-(2ull<<20))*4096;
+        for(const auto& row:rows) {
+            const auto n=available(row,address);
+            if(!n||guest<row.guest_lo||guest>=row.guest_hi||guest-row.guest_lo!=address-row.address)continue;
+            ++hits;longest=std::max(longest,n);payload|=!row.before_sha.empty()&&!row.after_sha.empty();
+        }
+        if(!hits)++result.unresolved;
+        else {if(hits>1)++result.ambiguous;if(longest<4096)++result.partial;if(!payload)++result.missing_payload;}
+    }
+    return result;
+}
+inline bool write_manifest(const oo_pt::Request& req,uint64_t completed,const std::vector<Row>& rows,
+                           const std::vector<Descriptor>& descriptors,const std::vector<std::string>& failures,
+                           bool after_recorded,bool invalidated,bool table_exported,const TableCoverage& table,uint64_t candidate_bytes) {
+    if(!config().enabled||!req.submitted_sequence||completed<req.submitted_sequence)return false;
+    const auto root=std::filesystem::path(oo_pt::config().directory);
+    const auto path=root/"allocations.json",part=root/"allocations.json.part";
+    if(oo_pt::present(path))return false;
+    FILE* f=std::fopen(part.string().c_str(),"wbx");if(!f)return false;
+    bool ok=std::fprintf(f,"{\"schema\":\"open-ocarina.gpu-allocations/v1\",\"replay_complete\":false,"
+      "\"recording_part\":%llu,\"recording_sequence\":%llu,\"completed_recording_sequence\":%llu,"
+      "\"program\":\"%016llx\",\"variant\":\"%016llx\",\"spirv_sha256\":\"%s\","
+      "\"candidate_count\":%zu,\"candidate_bytes\":%llu,\"required_staging_bytes\":%llu,\"budget_bytes\":%llu,\"table_manifest\":\"manifest.json\",\"table_exported\":%s,"
+      "\"before_position\":\"immediately before selected dispatch\",\"after_position\":\"immediately after selected dispatch\","
+      "\"table_resolution\":{\"mapped\":%llu,\"unresolved\":%llu,\"ambiguous\":%llu,\"partial\":%llu,\"missing_payload\":%llu},\"after_recorded\":%s,\"mapped_memory_invalidated\":%s,"
+      "\"coverage\":{\"images\":false,\"temporal_state\":false,\"underlying_import_aliases_resolved\":false,"
+      "\"cpu_writers_quiesced\":false,\"complete_physical_replay\":false},\"failures\":[",
+      (unsigned long long)req.recording_part,(unsigned long long)req.submitted_sequence,(unsigned long long)completed,
+      (unsigned long long)req.key,(unsigned long long)req.variant,req.shader_digest.c_str(),
+      rows.size(),(unsigned long long)candidate_bytes,(unsigned long long)(candidate_bytes*2),
+      (unsigned long long)config().budget,table_exported?"true":"false",
+      (unsigned long long)table.mapped,(unsigned long long)table.unresolved,(unsigned long long)table.ambiguous,
+      (unsigned long long)table.partial,(unsigned long long)table.missing_payload,after_recorded?"true":"false",invalidated?"true":"false")>=0;
+    for(size_t i=0;i<failures.size();++i)ok&=std::fprintf(f,"%s\"%s\"",i?",":"",failures[i].c_str())>=0;
+    ok&=std::fprintf(f,"],\"buffers\":[")>=0;
+    for(size_t i=0;i<rows.size();++i) {
+        const auto& r=rows[i];
+        std::string pieces="[";
+        for(size_t n=0;n<r.memory_pieces.size();++n){char text[32];std::snprintf(text,sizeof text,"\"%016llx\"",(unsigned long long)r.memory_pieces[n]);if(n)pieces+=",";pieces+=text;}
+        pieces+="]";
+        ok&=std::fprintf(f,"%s{\"id\":%zu,\"buffer\":\"%016llx\",\"address\":\"%016llx\",\"size\":%llu,"
+          "\"guest_lo\":\"%016llx\",\"guest_hi\":\"%016llx\",\"memory\":\"%016llx\",\"memory_offset\":%llu,"
+          "\"memory_piece_count\":%llu,\"memory_piece_handles\":%s,\"usage\":%llu,\"role\":\"%s\",\"copy_supported\":%s,"
+          "\"before\":%s,\"after\":%s}",i?",":"",i,(unsigned long long)r.buffer,(unsigned long long)r.address,
+          (unsigned long long)r.size,(unsigned long long)r.guest_lo,(unsigned long long)r.guest_hi,(unsigned long long)r.memory,
+          (unsigned long long)r.memory_offset,(unsigned long long)r.piece_count,pieces.c_str(),(unsigned long long)r.usage,r.role.c_str(),
+          r.copy_supported?"true":"false",
+          r.before_sha.empty()?"null":("{\"artifact\":\"buffer-"+std::to_string(i)+"-before.bin\",\"sha256\":\""+r.before_sha+"\"}").c_str(),
+          r.after_sha.empty()?"null":("{\"artifact\":\"buffer-"+std::to_string(i)+"-after.bin\",\"sha256\":\""+r.after_sha+"\"}").c_str())>=0;
+    }
+    ok&=std::fprintf(f,"],\"descriptors\":[")>=0;
+    for(size_t i=0;i<descriptors.size();++i) {
+        const auto& d=descriptors[i];
+        ok&=std::fprintf(f,"%s{\"binding\":%u,\"element\":%u,\"type\":%u,\"buffer\":\"%016llx\",\"offset\":%llu,\"range\":%llu}",
+          i?",":"",d.binding,d.element,d.type,(unsigned long long)d.buffer,(unsigned long long)d.offset,(unsigned long long)d.range)>=0;
+    }
+    ok&=std::fprintf(f,"]}\n")>=0;
+    ok&=std::fclose(f)==0;
+    if(!ok){std::remove(part.string().c_str());return false;}
+    std::error_code error;std::filesystem::rename(part,path,error);return !error;
+}
+} // namespace mkwvk::oo_alloc
