+
+/* The native camera runs outside controller reads. Query the same lease without
+   calling hos_control_input: that function starts queued inputs and may service
+   guest-memory requests, neither of which belongs in a camera ownership check. */
+int hos_control_input_exclusive(void) {
+    if (!hos_control_on || !G.game || !G.game->frame) return 0;
+    const int64_t frame = G.game->frame();
+    int exclusive = 0;
+    ctl_lock(&G.mu);
+    for (int i = 0; i < CTL_INPUTS; i++) {
+        const Input *in = &G.inputs[i];
+        if (hos_control_exclusive_policy(in->used, in->exclusive, in->start, in->frames, frame)) {
+            exclusive = 1;
+            break;
+        }
     }
