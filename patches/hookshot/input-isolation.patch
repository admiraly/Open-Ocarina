diff --git a/host/input_isolation.h b/host/input_isolation.h
new file mode 100644
--- /dev/null
+++ b/host/input_isolation.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Script/control input isolation policy; no game memory or device dependencies.
+#pragma once
+#include <stdint.h>
+
+static inline int hos_script_exclusive_policy(int enabled, int persistent, int presses,
+                                               int64_t elapsed_ms, int64_t end_ms) {
+    if (!enabled || presses <= 0 || end_ms < 0) return 0;
+    if (persistent) return 1;
+    if (elapsed_ms < end_ms) return 1;
+    return elapsed_ms - end_ms < 5000;
+}
+
+static inline int hos_control_exclusive_policy(int used, int exclusive, int64_t start,
+                                                int64_t frames, int64_t frame) {
+    if (!used || !exclusive || frames <= 0) return 0;
+    if (start < 0 || frame < start) return 1;
+    return frame - start < frames;
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+int hos_input_player_exclusive(void);
+#ifdef __cplusplus
+}
+#endif
