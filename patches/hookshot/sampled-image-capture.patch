+    <<",\"program\":\""<<hex(request.key)<<"\",\"variant\":\""<<hex(request.variant)<<"\",\"spirv_sha256\":\""<<request.shader_digest
+    <<"\",\"recording_part\":"<<request.recording_part<<",\"recording_sequence\":"<<request.submitted_sequence<<",\"completed_recording_sequence\":"<<completed
+    <<",\"selected_occurrence\":"<<occurrence<<",\"image_budget_bytes\":"<<config().budget<<",\"aggregate_budget_bytes\":"<<oo_alloc::config().budget
+    <<",\"buffer_staging_bytes\":"<<buffer_staging<<",\"command_position\":\"before selected compute dispatch\",\"mapped_memory_invalidated\":"<<(invalidated?"true":"false")
+    <<",\"coverage\":{\"image_physical_aliases_resolved\":false,\"cpu_writers_quiesced\":false,\"temporal_state\":false,\"complete_push_constants\":false,\"submitted_descriptor_words_decoded\":false},\"failures\":[";
+ for(size_t n=0;n<failures.size();++n){if(n)out<<',';out<<'"'<<failures[n]<<'"';}out<<"],\"images\":[";
+ for(size_t n=0;n<rows.size();++n) {
+  const auto& r=rows[n];const auto& i=r.image;const auto& v=r.view;const auto& s=r.sampler;
+  if(n)out<<',';
+  out<<"{\"id\":"<<n<<",\"binding\":"<<r.binding<<",\"element\":"<<r.element<<",\"descriptor_type\":"<<r.type<<",\"descriptor_layout\":"<<r.layout
+     <<",\"image_view\":\""<<hex(r.image_view)<<"\",\"sampler_handle\":\""<<hex(r.sampler_handle)<<"\",\"image\":{\"handle\":\""<<hex(i.handle)
+     <<"\",\"memory\":\""<<hex(i.memory)<<"\",\"memory_offset\":"<<i.memory_offset<<",\"flags\":"<<i.flags<<",\"type\":"<<i.type<<",\"format\":"<<i.format
+     <<",\"extent\":["<<i.width<<','<<i.height<<','<<i.depth<<"],\"mip_levels\":"<<i.mips<<",\"array_layers\":"<<i.layers<<",\"samples\":"<<i.samples
+     <<",\"tiling\":"<<i.tiling<<",\"usage\":"<<i.usage<<",\"sharing_mode\":"<<i.sharing<<",\"initial_layout\":"<<i.initial_layout
+     <<",\"queue_families\":"<<numbers(i.queue_families)<<",\"pnext_types\":"<<numbers(i.pnext_types)<<",\"format_list\":"<<numbers(i.format_list)<<",\"complete\":"<<(i.complete?"true":"false")
+     <<"},\"view\":{\"handle\":\""<<hex(v.handle)<<"\",\"image\":\""<<hex(v.image)<<"\",\"flags\":"<<v.flags<<",\"type\":"<<v.type<<",\"format\":"<<v.format
+     <<",\"components\":"<<numbers(v.components)<<",\"aspect\":"<<v.aspect<<",\"base_mip\":"<<v.base_mip<<",\"mip_count\":"<<v.mip_count
+     <<",\"base_layer\":"<<v.base_layer<<",\"layer_count\":"<<v.layer_count<<",\"usage\":"<<v.usage<<",\"explicit_usage\":"<<(v.explicit_usage?"true":"false")
+     <<",\"pnext_types\":"<<numbers(v.pnext_types)<<",\"complete\":"<<(v.complete?"true":"false")<<"},\"sampler\":{\"handle\":\""<<hex(s.handle)
+     <<"\",\"core_words\":"<<numbers(s.core)<<",\"complete\":"<<(s.complete?"true":"false")<<",\"pnext\":[";
+  for(size_t e=0;e<s.extensions.size();++e){if(e)out<<',';out<<"{\"type\":"<<s.extensions[e].type<<",\"words\":"<<numbers(s.extensions[e].words)<<'}';}
+  out<<"]},\"copy\":{\"supported\":"<<(r.copy.supported?"true":"false")<<",\"reason\":\""<<r.copy.reason<<"\",\"bytes\":"<<r.copy.bytes<<",\"block\":["<<r.copy.bw<<','<<r.copy.bh<<','<<r.copy.bpb<<"],\"layers\":"<<r.copy.layers<<",\"mips\":[";
+  for(size_t m=0;m<r.copy.mips.size();++m){const auto& x=r.copy.mips[m];if(m)out<<',';out<<"{\"level\":"<<x.level<<",\"extent\":["<<x.width<<','<<x.height<<','<<x.depth<<"],\"offset\":"<<x.offset<<",\"bytes\":"<<x.bytes<<'}';}
+  out<<"]},\"before\":";
+  if(r.payload_sha.empty())out<<"null";else out<<"{\"artifact\":\"image-"<<n<<"-before.bin\",\"sha256\":\""<<r.payload_sha<<"\"}";
+  out<<",\"failures\":[";for(size_t f=0;f<r.failures.size();++f){if(f)out<<',';out<<'"'<<r.failures[f]<<'"';}out<<"]}";
