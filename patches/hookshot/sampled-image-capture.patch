+};
+struct Mip { uint32_t level=0,width=0,height=0,depth=0;uint64_t offset=0,bytes=0; };
+struct Plan { bool supported=false;std::string reason;uint32_t bw=0,bh=0,bpb=0,layers=0;uint64_t bytes=0;std::vector<Mip> mips; };
+inline std::array<uint32_t,3> block(uint32_t f) {
+ if(f>=9&&f<=15)return {1,1,1};if(f>=16&&f<=22)return {1,1,2};
+ if(f>=37&&f<=69)return {1,1,4};if(f>=70&&f<=76)return {1,1,2};
+ if(f>=77&&f<=83)return {1,1,4};if(f>=91&&f<=97)return {1,1,8};
+ if(f>=98&&f<=100)return {1,1,4};if(f>=101&&f<=103)return {1,1,8};
+ if(f>=107&&f<=109)return {1,1,16};if(f==122||f==123)return {1,1,4};
+ if(f>=131&&f<=146)return {4,4,((f<=134)||(f>=139&&f<=140))?8u:16u};
