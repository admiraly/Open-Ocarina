+  p.mips.push_back(m);
+ }
+ uint64_t rounded=0;if(!add(p.bytes,3,rounded))return fail("image_footprint_overflow");p.bytes=rounded/4*4;
+ p.supported=true;return p;
+}
+struct Row {
+ uint32_t binding=0,element=0,type=0,layout=0;
