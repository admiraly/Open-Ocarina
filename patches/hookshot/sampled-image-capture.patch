+struct Config { bool enabled=false; uint64_t budget=256ull<<20; };
+inline const Config& config() {
+ static const Config result=[] {
+  Config c;const char* enabled=std::getenv("RX_VK_OO_IMAGES");
+  if(!enabled||std::string(enabled)!="1"||!oo_alloc::config().enabled)return c;
+  if(const char* cap=std::getenv("RX_VK_OO_IMAGE_BUDGET_MIB")) {
+   uint64_t n=0;if(!oo_alloc::decimal_bound(cap,8,4096,n)){std::fprintf(stderr,"Open-Ocarina: invalid image budget; image capture disabled\n");return c;}c.budget=n<<20;
+  }
+  for(const char* name:{"images.json","images.json.part"})if(oo_pt::present(std::filesystem::path(oo_pt::config().directory)/name))return c;
+  c.enabled=true;return c;
+ }();return result;
+}
+struct Image {
+ uint64_t handle=0,memory=0,memory_offset=0;
+ uint32_t flags=0,type=0,format=0,width=0,height=0,depth=0,mips=0,layers=0,samples=0,tiling=0,usage=0,sharing=0,initial_layout=0;
+ std::vector<uint32_t> queue_families,pnext_types,format_list;
