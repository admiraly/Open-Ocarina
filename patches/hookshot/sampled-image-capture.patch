+inline std::string hex(uint64_t value){char text[32];std::snprintf(text,sizeof text,"%016llx",(unsigned long long)value);return text;}
+template<class Range>inline std::string numbers(const Range& range){std::string out="[";bool comma=false;for(auto value:range){if(comma)out+=",";comma=true;out+=std::to_string(value);}return out+"]";}
+inline bool write_manifest(const oo_pt::Request& request,uint64_t completed,uint64_t occurrence,
