+}
+inline bool add(uint64_t a,uint64_t b,uint64_t& out){if(a>UINT64_MAX-b)return false;out=a+b;return true;}
+inline bool mul(uint64_t a,uint64_t b,uint64_t& out){if(b&&a>UINT64_MAX/b)return false;out=a*b;return true;}
+inline Plan plan(const Image& image,const View& view,uint32_t layout) {
+ Plan p;auto fail=[&](const char* why){p.reason=why;return p;};
+ if(!image.complete||!view.complete)return fail("unsupported_create_info_pnext_or_ownership");
+ if(!image.handle||view.image!=image.handle)return fail("image_view_owner_unknown");
+ if(layout!=1)return fail("descriptor_layout_not_general");
+ if(image.flags&~(8u|16u|128u|256u))return fail("unsupported_image_flags_sparse_alias_or_protected");
+ if(image.samples!=1||image.type>1||image.depth!=1)return fail("unsupported_multisample_or_three_dimensional_image");
+ if(view.aspect!=1)return fail("unsupported_noncolor_aspect");
+ if(!(image.usage&1)||!(image.usage&4))return fail("image_transfer_or_sample_usage_missing");
+ const uint32_t usage=view.explicit_usage?view.usage:image.usage;
+ if(!(usage&4)||(usage&image.usage)!=usage)return fail("view_usage_conflicts_with_image");
+ if(view.format!=image.format&&!(image.flags&8))return fail("view_format_conflicts_with_image");
+ if(image.type==0&&image.height!=1)return fail("invalid_image_or_view_bounds");
+ if(view.flags||!(image.width&&image.height&&image.mips&&image.layers)||image.mips>32)return fail("invalid_image_or_view_bounds");
+ if((image.type==0&&(view.type!=0&&view.type!=4))||(image.type==1&&(view.type!=1&&view.type!=3&&view.type!=5&&view.type!=6)))return fail("unsupported_view_type");
+ if(view.base_mip>=image.mips||view.base_layer>=image.layers)return fail("view_subresource_out_of_bounds");
+ uint32_t maximum_levels=0;for(uint32_t d=std::max(image.width,image.height);d;d>>=1)++maximum_levels;
+ if(image.mips>maximum_levels)return fail("invalid_image_or_view_bounds");
+ const uint32_t count=view.mip_count==UINT32_MAX?image.mips-view.base_mip:view.mip_count;
+ p.layers=view.layer_count==UINT32_MAX?image.layers-view.base_layer:view.layer_count;
+ if(!count||count>image.mips-view.base_mip||!p.layers||p.layers>image.layers-view.base_layer)return fail("view_subresource_out_of_bounds");
+ if((view.type==0||view.type==1)&&p.layers!=1)return fail("view_subresource_out_of_bounds");
+ if((view.type==3||view.type==6)&&(!(image.flags&16)||image.width!=image.height||p.layers%6||(view.type==3&&p.layers!=6)))return fail("view_subresource_out_of_bounds");
+ const auto b=block(image.format);p.bw=b[0];p.bh=b[1];p.bpb=b[2];if(!p.bpb)return fail("unsupported_backing_format");
+ for(uint32_t n=0;n<count;++n) {
