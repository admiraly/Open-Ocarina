+    static SystemProbeResult? ProbeSystem(Tools tools)
+    {
+        try
+        {
+            var si = new ProcessStartInfo(tools.Python)
+            {
+                WorkingDirectory = tools.Root,
+                UseShellExecute = false,
+                CreateNoWindow = true,
+                RedirectStandardOutput = true,
+                RedirectStandardError = true,
+            };
+            if (tools.PythonArgs != null)
+                foreach (var a in tools.PythonArgs)
+                    si.ArgumentList.Add(a);
+            si.ArgumentList.Add("-I");
+            si.ArgumentList.Add("-B");
+            si.ArgumentList.Add(System.IO.Path.Combine(tools.Root, "nx2", "make_game.py"));
+            si.ArgumentList.Add("--probe-system");
+            using var p = Process.Start(si);
+            if (p == null) return null;
+            var json = p.StandardOutput.ReadToEnd();
+            p.WaitForExit(5000);
+            if (p.ExitCode != 0 || string.IsNullOrWhiteSpace(json)) return null;
+            return System.Text.Json.JsonSerializer.Deserialize<SystemProbeResult>(json,
+                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
+        }
+        catch (Exception) { return null; }
+    }
