diff --git a/nx2/system_probe.py b/nx2/system_probe.py
new file mode 100644
index 0000000..cc88ce7
--- /dev/null
+++ b/nx2/system_probe.py
@@ -0,0 +1,311 @@
+"""Probe the host GPU and Vulkan driver without external tools.
+
+Loads vulkan-1.dll (Windows) or libvulkan.so.1 (Linux) via ctypes and queries
+physical devices, Vulkan API version, device-local VRAM, and VK_EXT_mesh_shader.
+Run with --json for machine-readable output.
+"""
+import ctypes
+import json
+import os
+import platform
+import subprocess
+import sys
+
+VK_SUCCESS = 0
+VK_INCOMPLETE = 5
+VK_MEMORY_HEAP_DEVICE_LOCAL_BIT = 0x1
+VK_EXT_MESH_SHADER_EXTENSION_NAME = b"VK_EXT_mesh_shader"
+
+DEVICE_TYPES = {
+    0: "other",
+    1: "integrated",
+    2: "discrete",
+    3: "virtual",
+    4: "cpu",
+}
+
+VENDORS = {
+    0x10DE: "nvidia",
+    0x1002: "amd",
+    0x8086: "intel",
+}
+
+
+class VkApplicationInfo(ctypes.Structure):
+    _fields_ = [
+        ("sType", ctypes.c_uint32),
+        ("pNext", ctypes.c_void_p),
+        ("pApplicationName", ctypes.c_char_p),
+        ("applicationVersion", ctypes.c_uint32),
+        ("pEngineName", ctypes.c_char_p),
+        ("engineVersion", ctypes.c_uint32),
+        ("apiVersion", ctypes.c_uint32),
+    ]
+
+
+class VkInstanceCreateInfo(ctypes.Structure):
+    _fields_ = [
+        ("sType", ctypes.c_uint32),
+        ("pNext", ctypes.c_void_p),
+        ("flags", ctypes.c_uint32),
+        ("pApplicationInfo", ctypes.POINTER(VkApplicationInfo)),
+        ("enabledLayerCount", ctypes.c_uint32),
+        ("ppEnabledLayerNames", ctypes.c_void_p),
+        ("enabledExtensionCount", ctypes.c_uint32),
+        ("ppEnabledExtensionNames", ctypes.c_void_p),
+    ]
+
+
+class VkPhysicalDeviceLimits(ctypes.Structure):
+    # Only total size matters (504 bytes in Vulkan 1.0+ spec); keep exact padding.
+    _fields_ = [("_raw", ctypes.c_uint8 * 504)]
+
+
+class VkPhysicalDeviceSparseProperties(ctypes.Structure):
+    _fields_ = [("residency", ctypes.c_uint32 * 5)]
+
+
+class VkPhysicalDeviceProperties(ctypes.Structure):
+    _fields_ = [
+        ("apiVersion", ctypes.c_uint32),
+        ("driverVersion", ctypes.c_uint32),
+        ("vendorID", ctypes.c_uint32),
+        ("deviceID", ctypes.c_uint32),
+        ("deviceType", ctypes.c_uint32),
+        ("deviceName", ctypes.c_char * 256),
+        ("pipelineCacheUUID", ctypes.c_uint8 * 16),
+        ("limits", VkPhysicalDeviceLimits),
+        ("sparseProperties", VkPhysicalDeviceSparseProperties),
+    ]
+
+
+class VkMemoryType(ctypes.Structure):
+    _fields_ = [
+        ("propertyFlags", ctypes.c_uint32),
+        ("heapIndex", ctypes.c_uint32),
+    ]
+
+
+class VkMemoryHeap(ctypes.Structure):
+    _fields_ = [
+        ("size", ctypes.c_uint64),
+        ("flags", ctypes.c_uint32),
+    ]
+
+
+class VkPhysicalDeviceMemoryProperties(ctypes.Structure):
+    _fields_ = [
+        ("memoryTypeCount", ctypes.c_uint32),
+        ("memoryTypes", VkMemoryType * 32),
+        ("memoryHeapCount", ctypes.c_uint32),
+        ("memoryHeaps", VkMemoryHeap * 16),
+    ]
+
+
+class VkExtensionProperties(ctypes.Structure):
+    _fields_ = [
+        ("extensionName", ctypes.c_char * 256),
+        ("specVersion", ctypes.c_uint32),
+    ]
+
+
+def _make_version(major, minor, patch=0):
+    return (major << 22) | (minor << 12) | patch
+
+
+def _decode_version(v):
+    return (v >> 22) & 0x7F, (v >> 12) & 0x3FF, v & 0xFFF
+
+
+def _load_vulkan():
+    names = ["vulkan-1.dll"] if os.name == "nt" else ["libvulkan.so.1", "libvulkan.so"]
+    for name in names:
+        try:
+            return ctypes.CDLL(name)
+        except OSError:
+            continue
+    return None
+
+
+def _probe_vulkan():
+    vk = _load_vulkan()
+    if vk is None:
+        return False, [], "Vulkan loader not found"
+
+    vkCreateInstance = vk.vkCreateInstance
+    vkCreateInstance.argtypes = [ctypes.POINTER(VkInstanceCreateInfo), ctypes.c_void_p, ctypes.POINTER(ctypes.c_void_p)]
+    vkCreateInstance.restype = ctypes.c_int32
+
+    vkDestroyInstance = vk.vkDestroyInstance
+    vkDestroyInstance.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
+    vkDestroyInstance.restype = None
+
+    vkEnumeratePhysicalDevices = vk.vkEnumeratePhysicalDevices
+    vkEnumeratePhysicalDevices.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint32), ctypes.POINTER(ctypes.c_void_p)]
+    vkEnumeratePhysicalDevices.restype = ctypes.c_int32
+
+    vkGetPhysicalDeviceProperties = vk.vkGetPhysicalDeviceProperties
+    vkGetPhysicalDeviceProperties.argtypes = [ctypes.c_void_p, ctypes.POINTER(VkPhysicalDeviceProperties)]
+    vkGetPhysicalDeviceProperties.restype = None
+
+    vkGetPhysicalDeviceMemoryProperties = vk.vkGetPhysicalDeviceMemoryProperties
+    vkGetPhysicalDeviceMemoryProperties.argtypes = [ctypes.c_void_p, ctypes.POINTER(VkPhysicalDeviceMemoryProperties)]
+    vkGetPhysicalDeviceMemoryProperties.restype = None
+
+    vkEnumerateDeviceExtensionProperties = vk.vkEnumerateDeviceExtensionProperties
+    vkEnumerateDeviceExtensionProperties.argtypes = [
+        ctypes.c_void_p,
+        ctypes.c_char_p,
+        ctypes.POINTER(ctypes.c_uint32),
+        ctypes.POINTER(VkExtensionProperties),
+    ]
+    vkEnumerateDeviceExtensionProperties.restype = ctypes.c_int32
+
+    instance = ctypes.c_void_p()
+    created = False
+    for api_ver in (_make_version(1, 3, 0), _make_version(1, 0, 0)):
+        app = VkApplicationInfo(
+            sType=0,
+            pNext=None,
+            pApplicationName=b"Open-Ocarina-Probe",
+            applicationVersion=1,
+            pEngineName=b"Open-Ocarina",
+            engineVersion=1,
+            apiVersion=api_ver,
+        )
+        ci = VkInstanceCreateInfo(
+            sType=1,
+            pNext=None,
+            flags=0,
+            pApplicationInfo=ctypes.pointer(app),
+            enabledLayerCount=0,
+            ppEnabledLayerNames=None,
+            enabledExtensionCount=0,
+            ppEnabledExtensionNames=None,
+        )
+        res = vkCreateInstance(ctypes.byref(ci), None, ctypes.byref(instance))
+        if res == VK_SUCCESS and instance.value:
+            created = True
+            break
+    if not created:
+        return False, [], "vkCreateInstance failed"
+
+    gpus = []
+    try:
+        count = ctypes.c_uint32(0)
+        res = vkEnumeratePhysicalDevices(instance, ctypes.byref(count), None)
+        if res != VK_SUCCESS or count.value == 0:
+            return True, [], "No Vulkan GPU found"
+        devs = (ctypes.c_void_p * count.value)()
+        res = vkEnumeratePhysicalDevices(instance, ctypes.byref(count), devs)
+        if res not in (VK_SUCCESS, VK_INCOMPLETE):
+            return True, [], "vkEnumeratePhysicalDevices failed"
+        for dev in devs[: count.value]:
+            props = VkPhysicalDeviceProperties()
+            vkGetPhysicalDeviceProperties(dev, ctypes.byref(props))
+            mem = VkPhysicalDeviceMemoryProperties()
+            vkGetPhysicalDeviceMemoryProperties(dev, ctypes.byref(mem))
+            vram_bytes = sum(
+                mem.memoryHeaps[i].size
+                for i in range(min(mem.memoryHeapCount, 16))
+                if mem.memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT
+            )
+            ext_count = ctypes.c_uint32(0)
+            has_mesh = False
+            if vkEnumerateDeviceExtensionProperties(dev, None, ctypes.byref(ext_count), None) == VK_SUCCESS and ext_count.value:
+                exts = (VkExtensionProperties * ext_count.value)()
+                if vkEnumerateDeviceExtensionProperties(dev, None, ctypes.byref(ext_count), exts) in (VK_SUCCESS, VK_INCOMPLETE):
+                    has_mesh = any(e.extensionName == VK_EXT_MESH_SHADER_EXTENSION_NAME for e in exts[: ext_count.value])
+
+            maj, min_, pat = _decode_version(props.apiVersion)
+            name = props.deviceName.decode("utf-8", errors="replace").strip()
+            vendor = VENDORS.get(props.vendorID, "other")
+            dtype = DEVICE_TYPES.get(props.deviceType, "other")
+            upper = name.upper()
+            gpus.append(
+                {
+                    "name": name,
+                    "vendor_id": props.vendorID,
+                    "vendor": vendor,
+                    "device_type": dtype,
+                    "api_version": f"{maj}.{min_}.{pat}",
+                    "vulkan_1_3": (maj > 1) or (maj == 1 and min_ >= 3),
+                    "vram_mb": int(vram_bytes // (1024 * 1024)),
+                    "mesh_shader": bool(has_mesh),
+                    "rtx": vendor == "nvidia" and "RTX" in upper,
+                    "rdna4": vendor == "amd" and ("RX 90" in upper or "RADEON RX 9" in upper),
+                }
+            )
+    finally:
+        vkDestroyInstance(instance, None)
+    return True, gpus, None
+
+
+def _pick_primary(gpus):
+    if not gpus:
+        return None
+    rank = {"discrete": 0, "integrated": 1, "virtual": 2, "other": 3, "cpu": 4}
+    return sorted(
+        gpus,
+        key=lambda g: (
+            0 if g["vulkan_1_3"] else 1,
+            rank.get(g["device_type"], 5),
+            -g["vram_mb"],
+        ),
+    )[0]
+
+
+def _fallback_gpu_names():
+    if os.name == "nt":
+        try:
+            out = subprocess.check_output(
+                ["powershell", "-NoProfile", "-Command", "(Get-CimInstance Win32_VideoController).Name"],
+                stderr=subprocess.DEVNULL,
+                text=True,
+                timeout=4,
+            )
+            return [line.strip() for line in out.splitlines() if line.strip()]
+        except Exception:
+            return []
+    return []
+
+
+def probe():
+    vk_ok, gpus, note = _probe_vulkan()
+    primary = _pick_primary(gpus)
+    vulkan_1_3 = bool(primary and primary["vulkan_1_3"] and primary["device_type"] != "cpu")
+    fallback_names = [] if gpus else _fallback_gpu_names()
+
+    if primary:
+        vram_gb = primary["vram_mb"] / 1024.0
+        vram_text = f" ({vram_gb:.0f} GB)" if vram_gb >= 1.5 else (f" ({primary['vram_mb']} MB)" if primary["vram_mb"] > 0 else "")
+        mesh_text = "Mesh shaders" if primary["mesh_shader"] else "Compute fallback (no hardware mesh shaders)"
+        if not vulkan_1_3:
+            summary = f"{primary['name']}{vram_text} · Vulkan {primary['api_version']} (Vulkan 1.3+ required)"
+        else:
+            summary = f"{primary['name']}{vram_text} · Vulkan {primary['api_version']} · {mesh_text}"
+    elif fallback_names:
+        summary = f"{fallback_names[0]} · No Vulkan 1.3 driver detected"
+    else:
+        summary = f"No Vulkan GPU detected ({note})" if note else "No Vulkan GPU detected"
+
+    return {
+        "os": platform.system().lower(),
+        "vulkan_ok": vk_ok,
+        "vulkan_1_3": vulkan_1_3,
+        "gpus": gpus,
+        "primary": primary,
+        "fallback_names": fallback_names,
+        "summary": summary,
+    }
+
+
+def probe_json():
+    return json.dumps(probe(), separators=(",", ":"))
+
+
+if __name__ == "__main__":
+    if "--json" in sys.argv:
+        print(probe_json())
+    else:
+        print(json.dumps(probe(), indent=2))
