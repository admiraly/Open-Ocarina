--- /dev/null
+++ b/gpu/vk/compute_selector_extract.h
@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Independently authored CPU prototype. Event consistency is not source-hook coverage.
+#ifndef OPEN_OCARINA_COMPUTE_SELECTOR_EXTRACT_H
+#define OPEN_OCARINA_COMPUTE_SELECTOR_EXTRACT_H
+#include "compute_interval_records.h"
+#include <map>
+#include <memory>
+#include <tuple>
+#include <type_traits>
+#include <utility>
+
+namespace open_ocarina::selector_extract {
+namespace ci = compute_intervals;
+using U = std::uint64_t;
+inline void need(bool value, const char* message) { if (!value) throw std::invalid_argument(message); }
+inline U add(U a,U b) { need(b<=UINT64_MAX-a,"range overflow"); return a+b; }
+struct Identity {
+    U program=0,variant=0;std::uint32_t nvn_stage=0,vk_stage=0,stage_count=0;std::string module;
+};
+inline bool target(const Identity& i) {
+    return i.program==0xcc62764061c44f6aULL&&i.variant==0x095931037888515aULL&&
+           i.nvn_stage==5&&i.vk_stage==32&&i.stage_count==1&&i.module==ci::kModuleSha256;
+}
+struct ImportInfo {
+    U lease=0,backing=0,generation=0,offset=0,size=0,mapping=0;
+    std::uint32_t kind=0,invalid_reason=0,abi=0,bytes=0;int result=0;
+    U acquired_event=0,current_generation=0,invalidated_event=0;
+};
+// Future production implementation must retain a real host backing lease and
+// validate it using the actual host ABI. Test implementations own synthetic data.
+struct ImportLease {
+    virtual ~ImportLease()=default;
+    virtual ImportInfo acquired() const=0;
+    virtual ImportInfo current() const=0;
+};
+struct PinInfo { U buffer=0,allocation=0,memory=0,memory_offset=0,size=0; };
+struct Retention {
+    virtual ~Retention()=default;
+    virtual PinInfo current() const=0;
+};
+struct RetainSource {
+    virtual ~RetainSource()=default;
+    virtual std::shared_ptr<Retention> acquire(U buffer)=0;
+};
+struct Record { U id=0,slot=0,part=0,reuse_after=0; };
+struct Writer { U id=0,generation=0,recording=0,part=0; };
+struct Value {
+    std::uint32_t binding=0,element=0,type=0;U buffer=0,offset=0,range=0;
+    friend bool operator==(const Value&a,const Value&b) {
+        return std::tie(a.binding,a.element,a.type,a.buffer,a.offset,a.range)==
+               std::tie(b.binding,b.element,b.type,b.buffer,b.offset,b.range);
+    }
+};
+template<class T> U handle_value(T value) {
+    if constexpr(std::is_pointer_v<T>)return U(reinterpret_cast<std::uintptr_t>(value));
+    else return U(value);
+}
+struct Dispatch {
+    enum class Kind { Direct, Indirect };Kind kind=Kind::Direct;
+    std::array<std::uint32_t,3> direct_grid{{1,1,1}};U arguments=0,arguments_offset=0,grid_copy_event=0;
+};
+class Bundle {
+    friend class Registry;
+    ci::Input input_;Writer writer_;U lease_=0,stream_generation_=0,upload_generation_=0;
+    Dispatch dispatch_;std::vector<std::shared_ptr<Retention>> pins_;std::vector<PinInfo> pin_facts_;
+    std::vector<std::shared_ptr<ImportLease>> imported_backings_;
+public:
+    const ci::Input& input() const { return input_; }
+    Writer writer() const { return writer_; }
+    U lease() const { return lease_; }
+    U stream_generation() const { return stream_generation_; }
+    U upload_generation() const { return upload_generation_; }
+    const Dispatch& dispatch() const { return dispatch_; }
+    // No mutable input accessor or live-to-owned conversion is provided.
+};
+
+// Exact VkWriteDescriptorSet/VkDescriptorBufferInfo member names, without a
+// Vulkan dependency. Read the final pending writer, never reconstruct bindings.
+template<class DW> std::vector<Value> pending_values(const DW& dw) {
+    need(dw.prog,"pending writer has no program");
+    need(dw.writes.size()<=64&&dw.bufs.size()<=256,"pending writer cap");
+    std::vector<Value> result;
+    const auto base=reinterpret_cast<std::uintptr_t>(dw.bufs.data());
+    using Info=typename std::decay_t<decltype(dw.bufs)>::value_type;
+    const auto bytes=dw.bufs.size()*sizeof(Info);
+    for(const auto& w:dw.writes) {
+        if(w.descriptorType!=6&&w.descriptorType!=7)continue;
+        need(w.descriptorCount&&w.descriptorCount<=256&&w.pBufferInfo,"missing pending buffer infos");
+        const auto at=reinterpret_cast<std::uintptr_t>(w.pBufferInfo);
+        need(at>=base&&at-base<=bytes&&(at-base)%sizeof(Info)==0&&
+             w.descriptorCount<=(bytes-(at-base))/sizeof(Info),"descriptor info pointer not in final writer");
+        for(std::uint32_t n=0;n<w.descriptorCount;++n) {
+            const auto& b=w.pBufferInfo[n];
+            result.push_back({w.dstBinding,w.dstArrayElement+n,w.descriptorType,
+                              handle_value(b.buffer),b.offset,b.range});
+        }
+    }
+    std::sort(result.begin(),result.end(),[](const Value&a,const Value&b){return std::tie(a.binding,a.element)<std::tie(b.binding,b.element);});
+    for(std::size_t n=1;n<result.size();++n)
+        need(std::tie(result[n-1].binding,result[n-1].element)!=std::tie(result[n].binding,result[n].element),"duplicate descriptor slot");
+    need(result.size()==10,"exact target uniform/storage descriptor inventory required");
+    std::size_t n=0;
+    for(std::uint32_t b=0;b<8;++b)for(std::uint32_t e=0;e<(b==7?3u:1u);++e,++n)
+        need(result[n].binding==b&&result[n].element==e&&result[n].type==(b<2?6u:7u),"target descriptor layout changed");
+    return result;
+}
+
+class Registry {
+    struct Memory { U handle=0,size=0;ci::Key backing;U backing_offset=0;std::shared_ptr<ImportLease> imported;ImportInfo acquisition;U instance=0; };
+    struct Buffer { U handle=0,allocation=0,memory=0,memory_offset=0,size=0;ci::Key key;U memory_instance=0;const std::uint8_t* mapped=nullptr; };
+    struct Upload { U offset=0,size=0,generation=0; };
+    struct Stream { U buffer=0,allocation=0,size=0,generation=0;const std::uint8_t* mapped=nullptr;ci::Key owner;std::vector<Upload> uploads; };
+    struct Rec { Record key;std::map<U,Stream> streams;U submitted=0; };
+    struct Pending { Writer key;Identity identity;const void* program=nullptr;std::vector<Value> values;U ready=0;std::vector<ci::Key> owners; };
+    struct Write { U event=0,recording=0;ci::WriteKind kind;ci::Key allocation;U offset=0,size=0; };
+    struct Grid { U writer=0,generation=0,destination=0,offset=0,source=0,source_offset=0,event=0;ci::Key source_owner; };
+    struct Lease { Writer writer;ci::Key backing;U c0_at=0;bool invalid=false;
+        std::vector<std::shared_ptr<Retention>> pins;std::vector<std::shared_ptr<ImportLease>> imports; };
+    U serial_=0,completed_=0;bool lost_=false;
+    std::map<U,Memory> memories_;std::map<U,Buffer> buffers_;std::map<U,Rec> recordings_;
+    std::map<U,U> slots_;std::map<U,Pending> writers_;std::map<U,Lease> leases_;std::map<U,Grid> grids_;
+    std::map<std::pair<U,U>,ci::Key> import_backings_;std::vector<Write> writes_;
+    U next() { need(!lost_&&serial_<UINT64_MAX,"registry unavailable/overflow");return ++serial_; }
+    Rec& rec(Record r) {
+        auto i=recordings_.find(r.id);need(i!=recordings_.end()&&i->second.key.slot==r.slot&&
+          i->second.key.part==r.part&&!i->second.submitted,"stale recording slot/part");return i->second;
+    }
+    const Buffer& buffer(U h) const { auto i=buffers_.find(h);need(i!=buffers_.end(),"unknown/destroyed buffer");return i->second; }
+    const Memory& memory(U h) const { auto i=memories_.find(h);need(i!=memories_.end(),"unknown/freed backing");return i->second; }
+    static void import_valid(const Memory& m) {
+        if(!m.imported)return;
+        const auto a=m.acquisition,b=m.imported->current();
+        need(a.result==1&&b.result==1&&a.abi==1&&b.abi==1&&a.bytes==88&&b.bytes==88&&
+          a.lease&&a.backing&&a.generation&&a.mapping&&a.size&&a.acquired_event&&
+          b.current_generation>=a.current_generation&&a.current_generation>=a.generation&&
+          !a.invalidated_event&&!b.invalidated_event&&(a.kind==1||a.kind==2)&&!a.invalid_reason&&
+          !b.invalid_reason&&std::tie(a.lease,a.backing,a.generation,a.offset,a.size,a.mapping,a.kind,a.acquired_event)==
+          std::tie(b.lease,b.backing,b.generation,b.offset,b.size,b.mapping,b.kind,b.acquired_event),"import backing lease changed or unknown");
+    }
+    ci::Owner owner(const Buffer& b,Record r) const {
+        const auto& m=memory(b.memory);import_valid(m);
+        need(b.memory_instance==m.instance,"buffer backing lifecycle generation changed");
+        need(b.memory_offset<=m.size&&b.size<=m.size-b.memory_offset,"buffer escapes backing allocation");
+        return {b.key,m.backing,add(m.backing_offset,b.memory_offset),b.size,r.id,r.id,r.reuse_after};
+    }
+    static bool protected_overlap(U c0,U at,U size) {
+        for(const auto s:ci::detail::kSelectors)if(ci::detail::overlap(add(c0,s),16,at,size))return true;
+        return false;
+    }
+    void possible_write(Record r,ci::WriteKind kind,U h,U offset,U size) {
+        rec(r);need(kind==ci::WriteKind::Host||kind==ci::WriteKind::Transfer||kind==ci::WriteKind::Storage||kind==ci::WriteKind::Physical,"unknown writer class");
+        const auto& b=buffer(h);const auto o=owner(b,r);
+        need(size&&offset<=b.size&&size<=b.size-offset,"writer outside actual owner");
+        need(writes_.size()<ci::kMaximumAdditionalWrites,"writer journal cap");
+        const auto event=next();writes_.push_back({event,r.id,kind,b.key,offset,size});
+        bool conflict=false;
