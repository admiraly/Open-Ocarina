+    void storage_write(Record r,U buffer,U offset,U size) {tracked_write(r,ci::WriteKind::Storage,buffer,offset,size);}
+    void physical_write(Record r,U buffer,U offset,U size) {tracked_write(r,ci::WriteKind::Physical,buffer,offset,size);}
+    void transfer_write(Record r,U buffer,U offset,U size) {tracked_write(r,ci::WriteKind::Transfer,buffer,offset,size);}
