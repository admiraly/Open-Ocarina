+// SPDX-License-Identifier: GPL-3.0-or-later
+// Independently authored exact-identity registry. Contains metadata, no shader words.
+#pragma once
+#include "mesh_warp32_lowering.h"
+#include <cstring>
+#include <array>
+namespace mkwvk::oo_mesh_warp32_profiles {
+inline constexpr uint32_t kRevision = 3;
+inline constexpr uint32_t kScratchBytes = 2 * 32 * sizeof(uint32_t);
+struct Target {
+    uint64_t program, variant;
+    const char *original, *fragment, *candidate;
+    uint32_t original_shared_bytes, payload_bytes, max_vertices, max_primitives, vertex_components;
+    constexpr uint32_t shared_bytes() const { return original_shared_bytes + kScratchBytes; }
+    constexpr uint32_t payload_shared_bytes() const { return payload_bytes + shared_bytes(); }
+};
+inline constexpr Target kD8{
+    oo_mesh_warp32::kProgram, oo_mesh_warp32::kVariant, oo_mesh_warp32::kOriginal,
+    oo_mesh_warp32::kFragment, oo_mesh_warp32::kCandidate, 14356, 128, 128, 128, 40};
+inline constexpr Target kProfile96{
+    0x68642bb810ee3e7cull, 0x3f3f5b29054673daull,
+    "999c8511db93d486543421dde7350e3d0034faa834ef3edaf3553dcdc9b55d93",
+    "3de1d79c321db3863dbb07de0d3fa0cdb126d72c07c2f1d70f0514eda3611b10",
+    "43434b023ff17ee4b92ed8e49f19c937c86f15cf31a7034161dd11878f944099",
+    11156, 128, 96, 96, 44};
+static_assert(kD8.shared_bytes() == 14612 && kProfile96.shared_bytes() == 11412);
+// Exact opt-in, independent of selected width. Unknown spellings remain off.
+inline bool parse_profile96(const char *value) { return value && !std::strcmp(value, "1"); }
+inline const Target *target(uint64_t program, bool profile96) {
+    if (program == kD8.program) return &kD8;
+    if (profile96 && program == kProfile96.program) return &kProfile96;
+    return nullptr;
+}
+inline bool requested(uint64_t program, uint32_t width, bool profile96) {
+    return (width == 8 || width == 16) && target(program, profile96);
+}
+inline std::array<uint32_t, 3> cache_policy(uint32_t width, bool profile96) {
+    return {kRevision, width, profile96 ? 1u : 0u};
+}
+inline uint64_t pipeline_tag(uint32_t width) {
+    return (width == 8 || width == 16) ? (0x4f4f573332030000ull | width) : 0;
+}
+template<class Subgroup, class Mesh>
+bool limits_match(uint32_t width, const Target& target, const Subgroup& subgroup, const Mesh& mesh) {
+    return (width == 8 || width == 16) && (subgroup.requiredSubgroupSizeStages & 128u) &&
+           subgroup.minSubgroupSize <= width && subgroup.maxSubgroupSize >= width &&
+           mesh.maxMeshWorkGroupInvocations >= 32 && mesh.maxMeshWorkGroupSize[0] >= 32 &&
+           mesh.maxMeshOutputVertices >= target.max_vertices && mesh.maxMeshOutputPrimitives >= target.max_primitives &&
+           mesh.maxMeshOutputComponents >= target.vertex_components &&
+           mesh.maxMeshSharedMemorySize >= target.shared_bytes() &&
+           mesh.maxMeshPayloadAndSharedMemorySize >= target.payload_shared_bytes();
+}
+inline bool identity_matches(const Target& t, uint64_t program, uint64_t variant,
+                             int mesh_nvn, uint32_t mesh_vk, int fragment_nvn, uint32_t fragment_vk,
+                             const std::string& mesh_sha, const std::string& fragment_sha) {
+    return program == t.program && variant == t.variant && mesh_nvn == 7 && mesh_vk == 128 &&
+           fragment_nvn == 1 && fragment_vk == 16 && mesh_sha == t.original && fragment_sha == t.fragment;
+}
+} // namespace mkwvk::oo_mesh_warp32_profiles
