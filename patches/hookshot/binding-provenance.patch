+class Ledger {
+ std::mutex mutex_;uint64_t serial_=0;bool lost_=false;
+ std::map<uint64_t,Object> buffers_,images_;std::map<uint64_t,Memory> memories_;
+ std::vector<Event> events_;
+ uint64_t next(){if(serial_==UINT64_MAX){lost_=true;return 0;}return ++serial_;}
+ uint64_t event(const char* kind,uint64_t object=0,uint64_t related=0,uint64_t offset=0,uint64_t size=0,uint64_t mo=0,uint64_t flags=0,int64_t result=0) {
+  if(events_.size()>=131072){lost_=true;return 0;}
+  const auto n=next();events_.push_back({n,object,related,offset,size,mo,flags,kind,result});return n;
+ }
+ std::map<uint64_t,Object>& objects(const std::string& kind){return kind=="image"?images_:buffers_;}
+public:
+ void lose(){std::lock_guard lock(mutex_);lost_=true;}
+ uint64_t attempt(const char* kind,uint64_t size) {std::lock_guard lock(mutex_);return event(kind,0,0,0,size);}
+ void failed(uint64_t attempt,int64_t result){std::lock_guard lock(mutex_);event("import_rollback",0,attempt,0,0,0,0,result);}
+ void memory(uint64_t handle,uint64_t size,const char* kind,LeasePtr lease={},uint64_t attempt=0) {
+  if(!handle)return;
+  std::lock_guard lock(mutex_);
+  if(memories_.count(handle)||memories_.size()>=65536){lost_=true;return;}
+  Memory m;m.id=next();m.handle=handle;m.size=size;m.kind=kind;m.lease=std::move(lease);m.created=event("memory_create",m.id,attempt,0,size);
+  memories_.emplace(handle,std::move(m));
+ }
+ LeasePtr free_memory(uint64_t handle){std::lock_guard lock(mutex_);auto it=memories_.find(handle);if(it==memories_.end()){if(handle)lost_=true;return {};}event("memory_free",it->second.id);auto lease=it->second.lease;memories_.erase(it);return lease;}
+ void object(uint64_t handle,uint64_t size,const char* kind="buffer",bool allocation=false) {
+  if(!handle)return;
+  std::lock_guard lock(mutex_);auto& table=objects(kind);
+  if(table.count(handle)||table.size()>=65536){lost_=true;return;}
+  Object o;o.id=next();o.handle=handle;o.size=size;o.kind=kind;o.allocation_id=allocation?next():0;o.created=event("resource_create",o.id,o.allocation_id,0,size);
+  table.emplace(handle,std::move(o));
+ }
+ void destroy(uint64_t handle,const char* kind="buffer") {std::lock_guard lock(mutex_);auto& table=objects(kind);auto it=table.find(handle);if(it==table.end()){if(handle)lost_=true;return;}event("resource_destroy",it->second.id,it->second.allocation_id);table.erase(it);}
