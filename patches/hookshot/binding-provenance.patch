+ std::vector<HosCaptureBackingEventV1> host_events;uint64_t host_endpoint=0;bool host_complete=true;
+ if(!validation.empty()) {
+  const auto& api=host_api();host_complete=api.events!=nullptr;
+  while(host_complete&&host_events.size()<65536) {
