+struct Host {
+ decltype(&hos_capture_backing_acquire) acquire=nullptr;
+ decltype(&hos_capture_backing_validate) validate=nullptr;
+ decltype(&hos_capture_backing_release) release=nullptr;
+ decltype(&hos_capture_backing_events) events=nullptr;
+};
+inline const Host& host_api() {
+ static const Host api=[] {Host h;
+#ifdef __linux__
+ h.acquire=reinterpret_cast<decltype(h.acquire)>(dlsym(RTLD_DEFAULT,"hos_capture_backing_acquire"));
+ h.validate=reinterpret_cast<decltype(h.validate)>(dlsym(RTLD_DEFAULT,"hos_capture_backing_validate"));
+ h.release=reinterpret_cast<decltype(h.release)>(dlsym(RTLD_DEFAULT,"hos_capture_backing_release"));
+ h.events=reinterpret_cast<decltype(h.events)>(dlsym(RTLD_DEFAULT,"hos_capture_backing_events"));
+#endif
+ return h;}();return api;
+}
+struct Lease {
+ Host api;HosCaptureBackingInfoV1 acquired{};int result=HOS_BACKING_UNKNOWN;
+ explicit Lease(Host h):api(h){}
+ ~Lease(){if(acquired.lease_id&&api.release)api.release(HOS_CAPTURE_BACKING_ABI,acquired.lease_id);}
+ Lease(const Lease&)=delete;Lease& operator=(const Lease&)=delete;
+};
+using LeasePtr=std::shared_ptr<Lease>;
+inline LeasePtr acquire(const Host& api,uint64_t guest,uint64_t size) {
+ auto lease=std::make_shared<Lease>(api);
+ if(api.acquire&&api.validate&&api.release)
+  lease->result=api.acquire(HOS_CAPTURE_BACKING_ABI,guest,size,&lease->acquired,sizeof(lease->acquired));
+ return lease;
+}
+inline bool valid_info(const HosCaptureBackingInfoV1& a,const HosCaptureBackingInfoV1& b,int result) {
+ // A disjoint discard may advance current_generation. The host validation result, immutable acquired
+ // fields, and invalid_reason determine consistency; generation equality alone would reject valid leases.
+ return result==HOS_BACKING_OK&&a.abi_version==HOS_CAPTURE_BACKING_ABI&&a.struct_size==sizeof(a)&&
+  !a.invalid_reason&&!a.invalidated_event&&(a.kind==HOS_BACKING_FILE||a.kind==HOS_BACKING_ANONYMOUS)&&b.kind==a.kind&&b.abi_version==HOS_CAPTURE_BACKING_ABI&&b.struct_size==sizeof(b)&&
+  !b.invalid_reason&&!b.invalidated_event&&b.lease_id==a.lease_id&&b.backing_id==a.backing_id&&
+  b.mapping_id==a.mapping_id&&b.backing_offset==a.backing_offset&&b.size==a.size&&
+  b.acquired_generation==a.acquired_generation&&b.acquired_event==a.acquired_event&&
+  b.current_generation>=a.current_generation&&a.lease_id&&a.backing_id&&a.acquired_generation;
+}
