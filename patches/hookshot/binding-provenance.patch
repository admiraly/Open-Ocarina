+}
+struct ImportAttempt {
+ uint64_t sequence=0;LeasePtr lease;bool committed=false;int64_t result=-1;
+ ImportAttempt(uint64_t guest,uint64_t size,const char* kind) {
+  if(!enabled())return;
+  // Acquired before udmabuf creation / VkImportMemoryHostPointerInfoEXT allocation.
+  lease=import_lease(guest,size);observe([&](Ledger& l){sequence=l.attempt(kind,size);});
+ }
+ void commit(uint64_t memory,uint64_t size,const char* kind) {
+  observe([&](Ledger& l){l.memory(memory,size,kind,lease,sequence);});committed=true;
+ }
+ ~ImportAttempt(){if(sequence&&!committed)observe([&](Ledger& l){l.failed(sequence,result);});}
+};
