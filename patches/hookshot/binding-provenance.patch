+ }
+ bool healthy(){std::lock_guard lock(mutex_);return !lost_;}
+};
+inline Ledger& ledger(){static Ledger value;return value;}
+template<class F> inline void observe(F fn) noexcept {if(!enabled())return;try{fn(ledger());}catch(...){ledger().lose();}}
+inline LeasePtr import_lease(uint64_t guest,uint64_t size) noexcept {
+ if(!enabled())return {};
