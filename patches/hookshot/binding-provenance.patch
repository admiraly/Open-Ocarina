+inline bool covered(const Object& object,const std::map<uint64_t,Memory>& memories) {
+ if(object.kind=="image")return object.edges.size()==1; // Exact image VMA allocation interval, not a linear image footprint.
+ std::vector<std::pair<uint64_t,uint64_t>> intervals;
+ for(const auto& e:object.edges) {
+  if(!memories.count(e.memory_id)||!e.sequence||(e.sparse&&!e.completion_sequence))return false;
+  const auto hi=std::min(object.size,e.resource_offset+e.size);if(e.resource_offset<hi)intervals.emplace_back(e.resource_offset,hi);
+ }
+ std::sort(intervals.begin(),intervals.end());uint64_t end=0;
+ for(const auto& i:intervals){if(i.first!=end)return false;end=i.second;}
+ return end==object.size&&object.size;
+}
+inline bool write_completed(const Snapshot& s,const oo_pt::Request& req,uint64_t completed,uint64_t occurrence,bool runtime_healthy=true) {
