+  std::lock_guard lock(mutex_);auto& table=objects(kind);auto object=table.find(handle);auto m=memories_.find(memory);
+  if(object==table.end()||m==memories_.end()||!size||resource_offset>UINT64_MAX-size||memory_offset>m->second.size||size>m->second.size-memory_offset){lost_=true;return;}
+  const auto seq=event(sparse?"sparse_bind_commit":"ordinary_bind_commit",object->second.id,m->second.id,resource_offset,size,memory_offset,flags);
+  object->second.edges.push_back({resource_offset,size,m->second.id,memory_offset,flags,seq,completed,sparse});
+ }
+ uint64_t sparse_submitted(uint64_t buffer,int64_t result){std::lock_guard lock(mutex_);auto it=buffers_.find(buffer);return event("sparse_queue_result",it==buffers_.end()?0:it->second.id,0,0,0,0,0,result);}
+ uint64_t sparse_completed(uint64_t submitted,int64_t result){std::lock_guard lock(mutex_);return event("sparse_fence_result",0,submitted,0,0,0,0,result);}
+ Snapshot snapshot(const std::vector<Wanted>& wanted) {
+  std::lock_guard lock(mutex_);Snapshot s;s.selected_sequence=event("capture_selected");s.lost=lost_;s.events=events_;
+  for(const auto& w:wanted) {
+   Captured c;c.wanted=w;auto& table=objects(w.kind);auto it=table.find(w.handle);
+   if(it!=table.end()){c.known=true;c.object=it->second;
+    for(const auto& edge:c.object.edges){auto m=std::find_if(memories_.begin(),memories_.end(),[&](const auto& p){return p.second.id==edge.memory_id;});
+     if(m==memories_.end())s.lost=true;else s.memories.emplace(m->second.id,m->second);}
+   }s.objects.push_back(std::move(c));
