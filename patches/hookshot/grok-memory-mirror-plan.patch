+
+uint32_t grok_chunk_gen(uint64_t page) {
+    const auto& chunk = gen_chunks[page / kChunkPages];
+    return chunk ? load_u32(chunk[page % kChunkPages]) : 0u;
+}
+
+// Sparse dirty pages, or one live run for a whole-region CPU stamp. A missing
+// note falls back to the page walk below, which stays the path when protection
+// or GPU-page tracking is on. Copies, capture slots and write notes match that walk.
+bool grok_mirror_plan(Pool& p, bool note_writes, std::vector<VkBufferCopy>& runs,
+                      std::map<VkBuffer, std::vector<VkBufferCopy>>& cap_runs) {
+    using open_ocarina::grok_memory::GrokCap;
+    using open_ocarina::grok_memory::GrokCopy;
+    using open_ocarina::grok_memory::GrokPlan;
+    using open_ocarina::grok_memory::kGrokCapture;
+    using open_ocarina::grok_memory::kGrokFallback;
+    std::vector<GrokCopy> planned;
+    struct Held { VkBuffer buffer; uint32_t gen; };
+    std::vector<Held> held;
+    const uint64_t begin = p.lo >> kPageShift;
+    const uint64_t end = (p.hi + 4095) >> kPageShift;
+    const int live = sync_live() ? 1 : 0;
+    for (uint64_t page = begin; page < end;) {
+        const uint64_t region = page / kRegionPages;
+        const uint64_t next = std::min(end, (region + 1) * kRegionPages);
+        const uint32_t generation = load_u32(region_gen[region]);
+        const uint32_t full = load_u32(region_full[region]);
+        uint64_t bits[8];
+        grok_region_notes()[region].snapshot(bits);
+        auto cap_of = [&](uint64_t pg) {
+            GrokCap cap{};
+            if (live) return cap;
+            const CapEntry entry = cap_entry(pg);
+            if (!entry.gen) return cap;
+            auto found = cap_bufs.find(entry.gen);
+            if (found == cap_bufs.end()) return cap;
+            uint32_t id = 0;
+            for (; id < held.size(); ++id)
+                if (held[id].gen == entry.gen) break;
+            if (id == held.size()) held.push_back({found->second.buffer, entry.gen});
+            cap.kept = 1;
+            cap.gen = entry.gen;
+            cap.slot = entry.slot;
+            cap.buffer = id;
+            return cap;
+        };
+        const GrokPlan plan = open_ocarina::grok_memory::grok_plan_region(
+            p.lo, p.hi, page, next, p.synced_gen, generation, full, bits, live, grok_chunk_gen, cap_of,
+            [](uint64_t) { return 0; }, planned);
+        if (plan == kGrokFallback) return false;
+        page = next;
+    }
+    for (const GrokCopy& copy : planned) {
+        const uint64_t pages = open_ocarina::grok_memory::grok_copy_pages(p.lo, copy.dst, copy.size);
+        if (copy.kind == kGrokCapture) {
+            const Held& h = held[copy.buffer];
+            append_capture_copy(cap_runs[h.buffer], {copy.src, copy.dst, copy.size});
+            auto found = cap_bufs.find(h.gen);
+            if (found != cap_bufs.end()) found->second.last_use = std::max(found->second.last_use, cur_cap_value);
+            (h.gen == cur_cap_gen ? st_sync_cap_pages : st_sync_old_pages) += (int64_t)pages;
+        } else {
+            runs.push_back({copy.dst, copy.dst, copy.size});
+            st_sync_live_pages += (int64_t)pages;
+            live_by_pool[p.lo] += (int64_t)pages;
+        }
+        if (note_writes) {
+            const uint64_t stop = p.lo + copy.dst + copy.size;
+            for (uint64_t at = p.lo + copy.dst; at < stop; at = ((at >> kPageShift) + 1) << kPageShift)
+                memory_note_cpu_access(at & ~uint64_t(4095), 1ull << kPageShift, true);
+        }
+    }
+    return true;
+}
