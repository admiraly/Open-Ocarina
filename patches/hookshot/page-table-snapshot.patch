diff --git a/gpu/vk/page_table_capture.h b/gpu/vk/page_table_capture.h
new file mode 100644
--- /dev/null
+++ b/gpu/vk/page_table_capture.h
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Opt-in, one-shot GPU-visible page-table snapshot. Not a complete replay.
+#pragma once
+#include "compute_identity.h"
+#include <filesystem>
+#include <system_error>
+
+namespace mkwvk::oo_pt {
+inline constexpr uint64_t kPageBytes=4096;
+inline constexpr uint64_t kEntries=((8ull<<30)/kPageBytes)+((4ull<<30)/kPageBytes);
+inline constexpr uint64_t kTableBytes=kEntries*8;
+struct Config { bool enabled=false; std::string directory,digest; };
+inline bool present(const std::filesystem::path& path) {
+    std::error_code error;
+    const auto status=std::filesystem::symlink_status(path,error);
+    return status.type()!=std::filesystem::file_type::not_found &&
+           status.type()!=std::filesystem::file_type::none;
+}
+inline const Config& config() {
+    static const Config result=[] {
+        Config c;
+        const char* directory=std::getenv("RX_VK_OO_PT_SNAPSHOT_DIR");
+        if(!directory||!*directory) return c;
+        c.directory=directory;
+        const char* digest=std::getenv("RX_VK_OO_PT_SNAPSHOT_SHA256");
+        c.digest=digest?digest:"b9af52c0ba07f64eb8b0ca2905c432d094999fdf669aa95182ff7754b510e97b";
+        if(c.digest.size()!=64||!oo_identity::config().enabled) {
+            std::fprintf(stderr,"Open-Ocarina: page snapshot requires identity observation and full shader digest\n");return c;
+        }
+        for(char& value:c.digest) {
+            if(value>='A'&&value<='F') value=char(value-'A'+'a');
+            if(!((value>='0'&&value<='9')||(value>='a'&&value<='f'))) return c;
+        }
+        std::error_code error;
+        if(!std::filesystem::is_directory(c.directory,error)) return c;
+        for(const char* name:{"page-table.bin","page-table.bin.part","manifest.json","manifest.json.part"})
+            if(present(std::filesystem::path(c.directory)/name)) {
+                std::fprintf(stderr,"Open-Ocarina: page snapshot directory already contains capture artifacts; disabled\n");return c;
+            }
+        c.enabled=true;return c;
+    }();return result;
+}
+inline bool selected(uint64_t key,uint64_t variant,const oo_identity::Identity& identity) {
+    return config().enabled&&identity.valid&&oo_identity::selected(key,variant)&&oo_identity::hex(identity.digest)==config().digest;
+}
+struct Request {
+    uint64_t key=0,variant=0,root_address=0,recording_part=0,logical_value=0,submitted_sequence=0;
+    int64_t present=0;
+    uint32_t root_push_offset=0,x=0,y=0,z=0;
+    bool indirect=false;
+    std::string shader_digest;
+};
+inline bool write_completed(const Request& request,const uint8_t* bytes,size_t size,uint64_t completed_sequence) {
+    if(!config().enabled||!bytes||size!=kTableBytes||!request.submitted_sequence||
+       completed_sequence<request.submitted_sequence||!request.root_address) return false;
+    const std::filesystem::path directory=config().directory;
+    const auto binary=directory/"page-table.bin",part=directory/"page-table.bin.part";
+    const auto manifest=directory/"manifest.json",manifest_part=directory/"manifest.json.part";
+    if(present(binary)||present(manifest)) return false;
+    FILE* file=std::fopen(part.string().c_str(),"wbx");
+    if(!file) return false;
+    const bool written=std::fwrite(bytes,1,size,file)==size;
+    const bool closed=std::fclose(file)==0;
+    if(!written||!closed) {std::remove(part.string().c_str());return false;}
+    const auto digest=oo_identity::hex(oo_identity::sha256(bytes,size));
+    std::error_code error;
+    if(present(binary)) {std::remove(part.string().c_str());return false;}
+    std::filesystem::rename(part,binary,error);
+    if(error) {std::remove(part.string().c_str());return false;}
+    file=std::fopen(manifest_part.string().c_str(),"wbx");
+    if(!file) return false; // Binary alone is never a committed snapshot.
+    char grid[96];
+    if(request.indirect)std::snprintf(grid,sizeof grid,"null");
+    else std::snprintf(grid,sizeof grid,"[%u,%u,%u]",request.x,request.y,request.z);
+    const int count=std::fprintf(file,
+      "{\"schema\":\"open-ocarina.gpu-page-table/v1\",\"producer\":{\"stage\":\"page-table-only\",\"replay_complete\":false},"
+      "\"pipeline\":{\"program\":\"%016llx\",\"variant\":\"%016llx\",\"spirv_sha256\":\"%s\"},"
+      "\"dispatch\":{\"kind\":\"%s\",\"group_count\":%s,\"present_observed\":%lld,\"identity_event_id\":null},"
+      "\"command_position\":\"immediately before selected compute dispatch, after descriptor and push binding\","
+      "\"submission\":{\"recording_part\":%llu,\"logical_value\":%llu,\"recording_sequence\":%llu,\"completed_recording_sequence\":%llu},"
+      "\"table\":{\"artifact\":\"page-table.bin\",\"size\":%llu,\"sha256\":\"%s\",\"entry_count\":%llu,\"entry_bytes\":8,\"byte_order\":\"little\","
+      "\"root_device_address\":\"%016llx\",\"root_push_offset\":%u,\"page_size\":4096,"
+      "\"windows\":[{\"guest_base\":\"1000000000\",\"size\":8589934592,\"first_entry\":0},{\"guest_base\":\"7f00000000\",\"size\":4294967296,\"first_entry\":2097152}]},"
+      "\"synchronization\":{\"source\":\"actual GPU guest_pages_buffer\",\"prior_writes_to_copy_barrier\":true,\"copy_to_host_barrier\":true,\"mapped_memory_invalidated\":true,"
+      "\"successful_exact_recording_submission\":true,\"recording_timeline_completion_checked\":true},"
+      "\"coverage\":{\"gpu_page_table\":true,\"referenced_allocation_contents\":false,\"descriptor_contents\":false,\"gpu_outputs\":false,\"temporal_state\":false},"
+      "\"limitations\":[\"No complete physical-memory capture or replay\",\"Table entries are device addresses, not copied allocation payloads\","
+      "\"Indirect dispatch counts remain unknown\",\"Recording sequence is completion evidence, not shader timing\"]}\n",
+      (unsigned long long)request.key,(unsigned long long)request.variant,request.shader_digest.c_str(),
+      request.indirect?"indirect":"direct",grid,(long long)request.present,(unsigned long long)request.recording_part,
+      (unsigned long long)request.logical_value,(unsigned long long)request.submitted_sequence,(unsigned long long)completed_sequence,
+      (unsigned long long)size,digest.c_str(),(unsigned long long)kEntries,(unsigned long long)request.root_address,request.root_push_offset);
+    const bool manifest_closed=std::fclose(file)==0;
+    if(count<0||!manifest_closed) {std::remove(manifest_part.string().c_str());return false;}
+    if(present(manifest)) {std::remove(manifest_part.string().c_str());return false;}
+    error.clear();std::filesystem::rename(manifest_part,manifest,error);
+    if(error) {std::remove(manifest_part.string().c_str());return false;}
+    return true;
+}
+} // namespace mkwvk::oo_pt
