+// SPDX-License-Identifier: GPL-3.0-or-later
+// Independently authored Open-Ocarina replay helper. No game code.
+//
+// Serial command-buffer state for the draw hot path. Both switches are opt-in
+// and default off (unset or "0" disables, "1" enables):
+//   RX_VK_GROK_REPLAY_BIND  dirty vertex ranges, at most 3 runs, else one
+//                           vkCmdBindVertexBuffers2 of all 16 slots
+//   RX_VK_GROK_REPLAY_PUSH  skip vkCmdPushConstants only for an unchanged
+//                           full-range payload on the same command buffer,
+//                           pipeline-layout handle and stage mask
+//
+// Push-constant compatibility is by layout handle, stage mask and the full
+// byte range. A different layout, a different stage mask, a subrange update
+// (mesh firsts, clears, compute helpers) or a new recording makes the cached
+// full payload unusable. Incompatible ranges overlap offset 0 at a different
+// size, so Vulkan leaves those bytes undefined; the next full push must be
+// issued. This helper does not merge partial ranges and does not drop draws,
+// barriers, descriptor writes or observer notes.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace grok_replay {
+
+struct VertexSlot {
+    uint64_t buffer = 0;
+    uint64_t offset = 0;
+    uint64_t size = 0;
+    uint64_t stride = 0;
+};
+
+inline bool vertex_slot_eq(const VertexSlot& a, const VertexSlot& b) {
+    return a.buffer == b.buffer && a.offset == b.offset && a.size == b.size && a.stride == b.stride;
+}
+
+// Returns the number of vkCmdBindVertexBuffers2 ranges, or -1 when the caller
+// must bind [0, n) in one call. Ranges are in increasing binding order.
+inline int vertex_bind_runs(bool valid, const VertexSlot* next, const VertexSlot* prev, int n,
+                            int* first, int* count, int max_runs) {
+    if (n <= 0 || !next || !first || !count || max_runs <= 0) return 0;
+    if (!valid || !prev) {
+        first[0] = 0;
+        count[0] = n;
+        return 1;
+    }
+    int runs = 0;
+    for (int i = 0; i < n;) {
+        if (vertex_slot_eq(next[i], prev[i])) {
+            ++i;
+            continue;
+        }
+        int j = i + 1;
+        while (j < n && !vertex_slot_eq(next[j], prev[j])) ++j;
+        if (runs >= max_runs) return -1;
+        first[runs] = i;
+        count[runs] = j - i;
+        ++runs;
+        i = j;
+    }
+    return runs;
+}
+
+inline bool push_unchanged(bool valid, uint64_t cmd, uint64_t layout, uint32_t stages,
+                           const uint8_t* data, uint32_t size, uint64_t cached_cmd, uint64_t cached_layout,
+                           uint32_t cached_stages, const uint8_t* cached, uint32_t cached_size) {
+    if (!valid || !data || !cached || !size || size != cached_size) return false;
+    if (cmd != cached_cmd || layout != cached_layout || stages != cached_stages) return false;
+    return std::memcmp(data, cached, size) == 0;
+}
+
+// Full-range payload remembered for one command buffer. 256 bytes covers the
+// renderer's kPushSize (MESH_FALLBACK_PUSH_END); a larger payload is not cached.
+struct PushRecord {
+    uint64_t cmd = 0;
+    uint64_t layout = 0;
+    uint32_t stages = 0;
+    uint32_t size = 0;
+    bool valid = false;
+    uint8_t bytes[256]{};
+};
+
+inline void push_invalidate(PushRecord& rec) { rec.valid = false; }
+
+// True when the caller must submit vkCmdPushConstants. False only when `enabled`
+// and the full payload is already on this command buffer. The observer is the
+// caller's responsibility and must run on both results.
+inline bool push_should_issue(PushRecord& rec, bool enabled, uint64_t cmd, uint64_t layout, uint32_t stages,
+                              const uint8_t* data, uint32_t size) {
+    if (enabled && push_unchanged(rec.valid, cmd, layout, stages, data, size, rec.cmd, rec.layout, rec.stages,
+                                  rec.bytes, rec.size))
+        return false;
+    if (!data || size == 0 || size > sizeof rec.bytes) {
+        rec.valid = false;
+        return true;
+    }
+    rec.cmd = cmd;
+    rec.layout = layout;
+    rec.stages = stages;
+    rec.size = size;
+    rec.valid = true;
+    std::memcpy(rec.bytes, data, size);
+    return true;
+}
+
+// Emits dirty binding ranges. `narrow` false, a new command buffer, or more
+// than three dirty runs emits one [0, 16) bind. Returns the run count, or -1
+// when the full bind was emitted.
+template <class Emit>
+inline int issue_vertex_ranges(bool narrow, bool last_valid, const VertexSlot* next, const VertexSlot* prev, Emit&& emit) {
+    int first[3], count[3];
+    if (!(narrow && last_valid && prev && next)) {
+        emit(0, 16);
+        return -1;
+    }
+    const int runs = vertex_bind_runs(true, next, prev, 16, first, count, 3);
+    if (runs <= 0) {
+        emit(0, 16);
+        return -1;
+    }
+    for (int r = 0; r < runs; ++r) emit(first[r], count[r]);
+    return runs;
+}
+
+}  // namespace grok_replay
