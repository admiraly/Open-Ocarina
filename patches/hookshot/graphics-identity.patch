+// SPDX-License-Identifier: GPL-3.0-or-later
+// Opt-in native mesh command identity. No resource snapshots or subgroup changes.
+#pragma once
+#include "compute_identity.h"
+#include <cerrno>
+#include <limits>
+
+namespace mkwvk::oo_graphics_identity {
+struct Config {
+    bool enabled=false, filter_variant=false;
+    std::string file;
+    std::vector<uint64_t> programs;
+    uint64_t variant=0, limit=128;
+};
+inline const Config& config() {
+    static const Config value=[] {
+        Config c;
+        const char* file=std::getenv("RX_VK_OO_GRAPHICS_IDENTITY_FILE");
+        if(!file||!*file)return c;
+        c.file=file;
+        const char* asked=std::getenv("RX_VK_OO_GRAPHICS_PROGRAMS");
+        const std::string list=asked?asked:"d8e59341cf4f629c,43ec86f35fd937b9";
+        for(size_t start=0;start<list.size();) {
+            const size_t end=list.find(',',start);
+            const std::string token=list.substr(start,end==std::string::npos?list.size()-start:end-start);
+            uint64_t key=0;
+            if(c.programs.size()==16||!oo_identity::hex64(token.c_str(),key))return Config{};
+            c.programs.push_back(key);
+            if(end==std::string::npos)break;
+            start=end+1;
+            if(start==list.size())return Config{};
+        }
+        if(c.programs.empty())return Config{};
+        if(const char* variant=std::getenv("RX_VK_OO_GRAPHICS_VARIANT")) {
+            if(!oo_identity::hex64(variant,c.variant))return Config{};
+            c.filter_variant=true;
+        }
+        if(const char* limit=std::getenv("RX_VK_OO_GRAPHICS_LIMIT")) {
+            if(!*limit)return Config{};
+            for(const char* p=limit;*p;++p)if(*p<'0'||*p>'9')return Config{};
+            char* end=nullptr;errno=0;const auto n=std::strtoull(limit,&end,10);
+            if(errno||!end||*end||n<1||n>256)return Config{};
+            c.limit=n;
+        }
+        c.enabled=true;return c;
+    }();
+    return value;
+}
+inline bool selected(uint64_t key,uint64_t variant) {
+    const auto& c=config();
+    if(!c.enabled||(c.filter_variant&&variant!=c.variant))return false;
+    for(uint64_t allowed:c.programs)if(key==allowed)return true;
+    return false;
+}
+inline void note_stage(bool native_mesh,uint64_t key,uint64_t variant,oo_identity::Identity& identity,
+                       const std::vector<uint32_t>& words) {
+    if(!native_mesh||!selected(key,variant))return;
+    identity={};
+    if(words.size()<5||words[0]!=0x07230203u)return;
+    std::vector<uint8_t> canonical(words.size()*4);
+    for(size_t j=0;j<words.size();++j)for(unsigned b=0;b<4;++b)canonical[j*4+b]=uint8_t(words[j]>>(8*b));
+    identity.digest=oo_identity::sha256(canonical.data(),canonical.size());
+    identity.words=words.size();identity.valid=true;
+}
+struct Stage {
+    int32_t nvn_stage=-1;
+    uint32_t vk_stage=0,required_size=0;
+    bool require_full=false;
+    oo_identity::Identity identity;
+};
+enum class Command { Direct, Indirect, IndirectCount };
+struct Event {
+    uint64_t key=0,variant=0,cache_stamp=0,pipeline_key=0,frame=0;
+    bool recording_known=false;
+    uint64_t recording_part=0,logical_recording_value=0;
+    std::array<Stage,8> stages{};
+    uint32_t stage_count=0;
+    Command command=Command::Direct;
+    bool converted=false,rewritten=false;
+    uint32_t group_count[3]{},max_draw_count=0,stride=0,first_task=0;
+    uint64_t argument_buffer=0,argument_offset=0,count_buffer=0,count_offset=0;
+    uint32_t width=0,height=0,samples=0,color_count=0,color_formats[8]{},depth_format=0;
+    uint32_t polygon_mode=0,cull_mode=0,front_face=0,blend_enable=0,color_write_mask=0;
+    uint32_t depth_test=0,depth_write=0,depth_compare=0,topology=0;
+    bool depth_clamp=false,alpha_to_coverage=false;
+    uint32_t vendor=0,device=0,driver=0;
+};
+inline bool arguments_valid(const Event& e,uint64_t& bytes) {
+    bytes=0;
+    if(e.command!=Command::Direct&&e.command!=Command::Indirect&&e.command!=Command::IndirectCount)return false;
+    if(e.command==Command::Direct)return !e.argument_buffer&&!e.count_buffer;
+    if(!e.argument_buffer||e.stride<12||e.stride%4)return false;
+    bytes=e.max_draw_count?uint64_t(e.max_draw_count-1)*e.stride+12:0;
+    if(e.argument_offset>std::numeric_limits<uint64_t>::max()-bytes)return false;
+    if(e.command==Command::IndirectCount)
+        return e.count_buffer&&e.count_offset<=std::numeric_limits<uint64_t>::max()-4;
+    return !e.count_buffer;
+}
+inline bool emit(const Event& e) {
+    if(!selected(e.key,e.variant))return false;
+    uint64_t argument_bytes=0;
+    if(!e.stage_count||e.stage_count>8||e.color_count>8||!arguments_valid(e,argument_bytes)) {
+        std::fprintf(stderr,"Open-Ocarina: invalid bounded graphics identity metadata; event refused\n");return false;
+    }
+    bool complete=true,has_mesh=false;
+    for(uint32_t i=0;i<e.stage_count;++i) {
+        const auto& st=e.stages[i];
+        const bool graphics_stage=st.vk_stage==1||st.vk_stage==2||st.vk_stage==4||st.vk_stage==8||st.vk_stage==16||st.vk_stage==64||st.vk_stage==128;
+        complete=complete&&st.identity.valid&&st.identity.words>=5&&graphics_stage&&st.nvn_stage>=0&&st.nvn_stage<8;
+        has_mesh=has_mesh||st.vk_stage==128;
+    }
+    complete=complete&&has_mesh;
+    static std::mutex mutex;
+    static uint64_t ordinal=0;
+    static const uint64_t run=uint64_t(std::chrono::system_clock::now().time_since_epoch().count());
+    std::lock_guard lock(mutex);
+    if(ordinal>=config().limit)return false;
+    FILE* out=std::fopen(config().file.c_str(),"ab");
+    if(!out){std::perror("Open-Ocarina graphics identity output");return false;}
+    const uint64_t current=ordinal++;
+    std::fprintf(out,"{\"schema\":\"open-ocarina.graphics-identity/v1\",\"producer\":{\"stage\":\"identity-only\",\"replay_complete\":false},"
+        "\"event_id\":\"%016llx-%llu\",\"identity_complete\":%s,\"pipeline\":{\"program\":\"%016llx\",\"variant\":\"%016llx\","
+        "\"cache_stamp\":\"%016llx\",\"pipeline_key\":\"%016llx\",\"entry_point\":\"main\",\"specialization\":[],\"stages\":[",
+        (unsigned long long)run,(unsigned long long)current,complete?"true":"false",(unsigned long long)e.key,
+        (unsigned long long)e.variant,(unsigned long long)e.cache_stamp,(unsigned long long)e.pipeline_key);
+    for(uint32_t i=0;i<e.stage_count;++i) {
+        const auto& st=e.stages[i];
+        const std::string digest=st.identity.valid?"\""+oo_identity::hex(st.identity.digest)+"\"":"null";
+        char required[32];if(st.required_size)std::snprintf(required,sizeof required,"%u",st.required_size);else std::snprintf(required,sizeof required,"null");
+        std::fprintf(out,"%s{\"index\":%u,\"nvn_stage\":%d,\"vk_stage\":%u,\"spirv\":{\"sha256\":%s,\"word_count\":%zu},"
+            "\"subgroup_request\":{\"required_size\":%s,\"require_full_subgroups\":%s},\"driver_selected_simd_width\":null}",
+            i?",":"",i,st.nvn_stage,st.vk_stage,digest.c_str(),st.identity.words,required,st.require_full?"true":"false");
+    }
+    const char* command=e.command==Command::Direct?"vkCmdDrawMeshTasksEXT":e.command==Command::Indirect?"vkCmdDrawMeshTasksIndirectEXT":"vkCmdDrawMeshTasksIndirectCountEXT";
+    std::fprintf(out,"]},\"draw\":{\"command\":\"%s\",\"converted_arguments\":%s,\"rewritten_arguments\":%s,\"selected_recording_ordinal\":%llu,"
+        "\"native_frame_observed\":%llu,\"first_task_requested\":%u,\"group_count\":",command,e.converted?"true":"false",e.rewritten?"true":"false",
+        (unsigned long long)current,(unsigned long long)e.frame,e.first_task);
+    if(e.command==Command::Direct)std::fprintf(out,"[%u,%u,%u],\"arguments\":null,\"count_argument\":null",e.group_count[0],e.group_count[1],e.group_count[2]);
+    else {
+        std::fprintf(out,"null,\"arguments\":{\"buffer_handle\":\"%016llx\",\"offset\":%llu,\"byte_extent\":%llu,\"stride\":%u,\"max_draw_count\":%u,\"api_draw_count\":",
+            (unsigned long long)e.argument_buffer,(unsigned long long)e.argument_offset,(unsigned long long)argument_bytes,e.stride,e.max_draw_count);
+        if(e.command==Command::Indirect)std::fprintf(out,"%u",e.max_draw_count);else std::fprintf(out,"null");
+        std::fprintf(out,"},\"count_argument\":");
+        if(e.command==Command::IndirectCount)std::fprintf(out,"{\"buffer_handle\":\"%016llx\",\"offset\":%llu,\"byte_extent\":4,\"value\":null}",(unsigned long long)e.count_buffer,(unsigned long long)e.count_offset);
+        else std::fprintf(out,"null");
+    }
+    std::fprintf(out,",\"gpu_executed_draw_count\":null,\"recording_part\":");
+    if(e.recording_known)std::fprintf(out,"%llu,\"logical_recording_value\":%llu",(unsigned long long)e.recording_part,(unsigned long long)e.logical_recording_value);
+    else std::fprintf(out,"null,\"logical_recording_value\":null");
+    std::fprintf(out,",\"recording_sequence\":null,\"gpu_completion_value\":null},\"attachments\":{\"width\":%u,\"height\":%u,\"sample_count_flag\":%u,\"depth_format\":%u,\"color_formats\":[",e.width,e.height,e.samples,e.depth_format);
+    for(uint32_t i=0;i<e.color_count;++i)std::fprintf(out,"%s%u",i?",":"",e.color_formats[i]);
+    std::fprintf(out,"]},\"requested_state\":{\"scope\":\"retained NVN values and Vulkan pipeline topology; not full effective dynamic state\","
+        "\"topology\":%u,\"polygon_mode\":%u,\"cull_mode\":%u,\"front_face\":%u,\"blend_enable\":%u,\"color_write_mask\":%u,"
+        "\"depth_test\":%u,\"depth_write\":%u,\"depth_compare\":%u,\"depth_clamp\":%s,\"alpha_to_coverage\":%s},"
+        "\"device\":{\"vendor_id\":%u,\"device_id\":%u,\"driver_version\":%u},"
+        "\"coverage\":{\"resource_contents\":false,\"descriptor_contents\":false,\"indirect_gpu_values\":false,\"physical_pointer_reachability\":false,"
+        "\"temporal_state\":false,\"gpu_outputs\":false,\"effective_dynamic_state_complete\":false},"
+        "\"ordinal_scope\":\"selected native mesh commands at CPU recording point; not queue order or GPU completion\"}\n",
+        e.topology,e.polygon_mode,e.cull_mode,e.front_face,e.blend_enable,e.color_write_mask,e.depth_test,e.depth_write,e.depth_compare,
+        e.depth_clamp?"true":"false",e.alpha_to_coverage?"true":"false",e.vendor,e.device,e.driver);
+    const bool ok=!std::ferror(out);
+    const bool closed=std::fclose(out)==0;
+    if(!ok||!closed)std::fprintf(stderr,"Open-Ocarina: graphics identity write failed; output is incomplete\n");
+    return ok&&closed;
+}
+} // namespace mkwvk::oo_graphics_identity
