+// Open-Ocarina native mesh identity only: no resource reads, copies or policy changes.
+void oo_graphics_identity_record(VkCommandBuffer cmd, const Program& p, const NvnState& s, const Targets& at,
+                                 VkPrimitiveTopology topology, const DrawArgs& d, oo_graphics_identity::Command command,
+                                 bool converted, bool rewritten, VkBuffer arguments, VkDeviceSize argument_offset,
+                                 uint32_t count, uint32_t stride, VkBuffer counter, VkDeviceSize counter_offset) {
+    if (!p.mesh || p.fallback || !oo_graphics_identity::selected(p.key, p.variant)) return;
+    oo_graphics_identity::Event event;
+    event.key = p.key; event.variant = p.variant; event.cache_stamp = program_cache_stamp();
+    event.pipeline_key = pipeline_key(p, s, at, topology); event.frame = texture_frame_no();
+    event.recording_known = memory_pt_recording_info(cmd, &event.recording_part, &event.logical_recording_value);
+    event.stage_count = (uint32_t)p.stages.size();
+    for (size_t i = 0; i < p.stages.size() && i < event.stages.size(); ++i) {
+        const auto& source = p.stages[i]; auto& stage = event.stages[i];
+        stage.nvn_stage = source.nvn_stage; stage.vk_stage = (uint32_t)source.vk_stage; stage.identity = source.oo_identity;
+        VkPipelineShaderStageCreateInfo info{VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+        info.stage = source.vk_stage; pin_subgroup(info);   // same request as build_graphics; not actual driver SIMD width
+        if (info.pNext) {
+            const auto* size = static_cast<const VkPipelineShaderStageRequiredSubgroupSizeCreateInfo*>(info.pNext);
+            if (size->sType == VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO)
+                stage.required_size = size->requiredSubgroupSize;
+        }
+        stage.require_full = (info.flags & VK_PIPELINE_SHADER_STAGE_CREATE_REQUIRE_FULL_SUBGROUPS_BIT) != 0;
+    }
+    event.command = command; event.converted = converted; event.rewritten = rewritten;
+    event.group_count[0] = (uint32_t)std::max(d.groups[0], 0);
+    event.group_count[1] = (uint32_t)std::max(d.groups[1], 1);
+    event.group_count[2] = (uint32_t)std::max(d.groups[2], 1);
+    event.argument_buffer = (uint64_t)(uintptr_t)arguments; event.argument_offset = argument_offset;
+    event.max_draw_count = count; event.stride = stride; event.first_task = d.first_task;
+    event.count_buffer = (uint64_t)(uintptr_t)counter; event.count_offset = counter_offset;
+    event.width = at.width; event.height = at.height; event.samples = (uint32_t)at.samples;
+    event.color_count = (uint32_t)at.n; event.depth_format = (uint32_t)at.depth_format;
+    for (int i = 0; i < at.n && i < 8; ++i) event.color_formats[i] = (uint32_t)at.color_format[i];
+    event.topology = (uint32_t)topology; event.polygon_mode = (uint32_t)s.poly.mode;
+    event.cull_mode = (uint32_t)s.poly.cull; event.front_face = (uint32_t)s.poly.front;
+    event.blend_enable = (uint32_t)s.color.blend_en; event.color_write_mask = s.chmask.mask;
+    event.depth_test = (uint32_t)s.ds.dt; event.depth_write = (uint32_t)s.ds.dw; event.depth_compare = (uint32_t)s.ds.df;
+    event.depth_clamp = s.depth_clamp; event.alpha_to_coverage = s.ms.a2c != 0;
+    event.vendor = dev.props.vendorID; event.device = dev.props.deviceID; event.driver = dev.props.driverVersion;
+    oo_graphics_identity::emit(event);
+}
