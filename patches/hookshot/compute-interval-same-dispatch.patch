+using U = uint64_t;
+inline constexpr const char *kModule =
+    "b9af52c0ba07f64eb8b0ca2905c432d094999fdf669aa95182ff7754b510e97b";
+inline constexpr U kBdaUsage = 0x00020000;
+inline constexpr U kUniformUsage = 0x10, kStorageUsage = 0x20;
+inline constexpr std::array<uint32_t, 8> kSelectors{
+    {192, 208, 256, 272, 352, 2176, 2192, 2208}};
+using C0Bytes = std::array<uint8_t, 2224>;
+enum class Scope { MetadataSameDispatch };
+enum class Creation { Unknown, VmaAllocationInfo2 };
+enum class StreamPolicy { Unknown, AppendOnlyUntilRecordingSlotCompletion };
+enum class FlushPolicy { Unknown, RegisteredRecordingSubmitFlush };
+enum class CopyPolicy { Unknown, MappedCopyAndStampSerialized };
+enum class WriteKind {
