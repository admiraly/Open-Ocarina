+enum class JournalState { Unknown, Recording, FailedSubmit, CapacityStopped };
+struct Denial {
+  std::string code;
+};
+inline void deny(std::vector<Denial> &d, const char *code) {
+  if (std::none_of(d.begin(), d.end(),
+                   [code](const Denial &x) { return x.code == code; }))
+    d.push_back({code});
+}
+struct Info {
+  uint32_t binding = 0, element = 0, type = 0;
+  U buffer = 0, offset = 0, range = 0;
+  friend bool operator==(const Info &a, const Info &b) {
+    return a.binding == b.binding && a.element == b.element &&
+           a.type == b.type && a.buffer == b.buffer && a.offset == b.offset &&
+           a.range == b.range;
+  }
+};
+struct Identity {
