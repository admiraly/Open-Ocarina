+struct SelectedC0 {
+  Owner owner;
+  Stream stream;
+  Copy copy;
+  std::vector<Upload> uploads;
+};
+struct MetadataSameDispatch {
+  Identity identity;
+  std::vector<Info> infos;
+  std::optional<C0Bytes> c0;
+  // Only VK_WHOLE_SIZE needs an actual resource-size observation. Finite
+  // original ranges retain the original renderer's SAME-dispatch precondition.
+  std::map<U, U> buffer_sizes;
+  std::optional<Cut> cut;
+  std::optional<SelectedC0> selected;
+  std::optional<Writes> writes;
+};
+struct Row {
+  U low = 0, high = 0, base = 0;
+  uint32_t binding = 0, element = 0;
+};
+struct Calculation;
+class Plan {
+  friend Calculation calculate(const MetadataSameDispatch &);
+  MetadataSameDispatch source_;
+  std::array<std::vector<Row>, 2> rows_;
+  std::vector<uint8_t> bytes_;
+
+public:
+  static constexpr Scope scope = Scope::MetadataSameDispatch;
+  static constexpr bool live_certificate = false, replacement_admitted = false;
+  const std::vector<uint8_t> &bytes() const { return bytes_; }
+  const std::array<std::vector<Row>, 2> &rows() const { return rows_; }
+  const std::vector<Info> &original_infos() const { return source_.infos; }
+  const MetadataSameDispatch &metadata() const { return source_; }
