+  U dispatch_instance = 0;
+  int slot = -1;
+  U writer = 0, built_generation = 0, current_generation = 0, program = 0;
+  std::vector<Info> current_infos;
+};
+// Raw lifecycle/API observations, not owner_known/no_alias/certificate flags.
+struct Owner {
