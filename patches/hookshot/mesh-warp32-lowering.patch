+
+void mesh_warp32_apply(Program& p, const std::vector<std::vector<uint32_t>>& original) {
+    const uint32_t width = mesh_warp32_requested_width();
+    if (!width || p.key != oo_mesh_warp32::kProgram) return;
+    const auto refused = [&](const char* reason) {
+        static std::atomic<unsigned> told{0};
+        if (told.fetch_add(1) < 32)
+            logf("vk: OO mesh-warp32 baseline retained: %s (requested %u, vendor %#x device %#x driver %#x)",
+                 reason, width, dev.props.vendorID, dev.props.deviceID, dev.props.driverVersion);
+    };
+    // Before ready publication only. No cache fields or descriptor metadata change.
+    if (!p.mesh || p.fallback || p.variant != oo_mesh_warp32::kVariant || p.stages.size() != 2 || original.size() != 2) {
+        refused("program/variant/stage shape"); return;
+    }
+    Stage& stage = p.stages[0];
+    if (stage.mesh_warp32_width) return;
+    if (!mesh_warp32_runtime_policy() || !mesh_warp32_device(width)) {
+        refused("unreviewed compiler policy/device/capabilities"); return;
+    }
+    try {
+        if (!oo_mesh_warp32::identity_matches(p.key, p.variant, stage.nvn_stage, (uint32_t)stage.vk_stage,
+                p.stages[1].nvn_stage, (uint32_t)p.stages[1].vk_stage,
+                mesh_warp32_digest(original[0]), mesh_warp32_digest(original[1]))) {
+            refused("exact original stage identities"); return;
+        }
+        const auto candidate = oo_mesh_warp32::rewrite(original[0]);
+        if (!candidate.ok) { refused(candidate.reason.c_str()); return; }
+        if (mesh_warp32_digest(candidate.words) != oo_mesh_warp32::kCandidate) {
+            refused("candidate digest differs from reviewed native writer"); return;
+        }
+        // Finish every allocating CPU step before committing a new module.
+        auto actual_identity = stage.oo_identity;
+        oo_identity::note_stage(p.key, p.variant, actual_identity, candidate.words);
+        oo_graphics_identity::note_stage(true, p.key, p.variant, actual_identity, candidate.words);
+        const VkShaderModule module = make_module(candidate.words);
+        if (!module) { refused("candidate module creation failed"); return; }
+        const VkShaderModule baseline = stage.module;
+        stage.module = module;
+        stage.mesh_warp32_width = width;
+        stage.oo_identity = actual_identity; // disk cache deliberately retains original words
+        if (baseline) vkDestroyShaderModule(dev.device, baseline, nullptr);
+        logf("vk: OO mesh-warp32 applied rev %u prog %016llx variant %016llx required %u shared 14612 source %s actual %s; safe-three compiler policy, MAX absent; pipeline failures have no baseline recovery",
+             oo_mesh_warp32::kRevision, (unsigned long long)p.key, (unsigned long long)p.variant,
+             width, oo_mesh_warp32::kOriginal, oo_mesh_warp32::kCandidate);
+    } catch (const std::exception& error) {
+        refused(error.what());
+    }
+}
