+            VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO, nullptr, 8};
+        static const VkPipelineShaderStageRequiredSubgroupSizeCreateInfo size16{
+            VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO, nullptr, 16};
+        info.pNext = width == 8 ? &size8 : &size16;
+        info.flags &= ~VK_PIPELINE_SHADER_STAGE_CREATE_REQUIRE_FULL_SUBGROUPS_BIT;
+        return;
+    }
+    pin_subgroup(info);
