+uint32_t mesh_warp32_requested_width() {
+    // Immutable for the process: a Program/pipeline is never hot-swapped.
+    static const uint32_t width = oo_mesh_warp32::parse_width(std::getenv("RX_VK_OO_MESH_WARP32"));
+    return width;
