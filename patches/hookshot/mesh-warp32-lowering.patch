+namespace {
+bool mesh_warp32_runtime_policy() {
+    if (env_on("RX_VK_NOOPT")) return false;
+    const std::pair<const char*, const char*> required[] = {
+        {"HS_SPILL_BATCH", "1"}, {"HS_PUSH_SHADOW", "1"}, {"shader_spilling_rate", "1"}};
+    for (const auto& item : required) {
+        const char* value = std::getenv(item.first);
+        if (!value || std::strcmp(value, item.second)) return false;
+    }
+    // MAX is a presence-based global compute fallback opt-in, even when empty/zero.
+    for (const char* key : {"HS_CS32_MAX_INSTS", "HS_FORCE_SIMD8", "HS_SUBGROUP8", "HS_SPILL_PCT",
+                            "HS_LARGE_GRF", "HS_LARGE_GRF_BIT", "HS_RA_DEBUG", "INTEL_DEBUG", "RX_VK_WARP64"})
+        if (std::getenv(key)) return false;
+    return true;
+}
+
+bool mesh_warp32_device(uint32_t width) {
+    // Deliberately a reviewed A770/Mesa configuration, not a portable lane rule.
+    if (!dev.physical || !dev.device || !dev.mesh_shader || !dev.vk13.subgroupSizeControl ||
+        dev.props.vendorID != 0x8086 || dev.props.deviceID != 0x56a0 ||
+        dev.driver_id != VK_DRIVER_ID_INTEL_OPEN_SOURCE_MESA || dev.props.driverVersion != 0x06802004 ||
+        !(dev.sg32_stages & VK_SHADER_STAGE_MESH_BIT_EXT)) return false;
+    VkPhysicalDeviceMeshShaderPropertiesEXT mesh{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MESH_SHADER_PROPERTIES_EXT};
+    VkPhysicalDeviceSubgroupSizeControlProperties subgroup{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_PROPERTIES};
+    subgroup.pNext = &mesh;
+    VkPhysicalDeviceProperties2 properties{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+    properties.pNext = &subgroup;
+    vkGetPhysicalDeviceProperties2(dev.physical, &properties);
+    return (subgroup.requiredSubgroupSizeStages & VK_SHADER_STAGE_MESH_BIT_EXT) &&
+           subgroup.minSubgroupSize <= width && subgroup.maxSubgroupSize >= width &&
+           mesh.maxMeshWorkGroupInvocations >= 32 && mesh.maxMeshWorkGroupSize[0] >= 32 &&
+           mesh.maxMeshOutputVertices >= 128 && mesh.maxMeshOutputPrimitives >= 128 &&
+           mesh.maxMeshSharedMemorySize >= 14612 && mesh.maxMeshPayloadAndSharedMemorySize >= 14740;
+}
+
+std::string mesh_warp32_digest(const std::vector<uint32_t>& words) {
+    std::vector<uint8_t> bytes(words.size() * 4);
+    for (size_t i = 0; i < words.size(); ++i)
+        for (unsigned b = 0; b < 4; ++b) bytes[i * 4 + b] = uint8_t(words[i] >> (b * 8));
+    return oo_identity::hex(oo_identity::sha256(bytes.data(), bytes.size()));
+}
