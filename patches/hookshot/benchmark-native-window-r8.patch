+       OO_BENCH_VALUE,OO_BENCH_PART,OO_BENCH_PLAN,OO_BENCH_HELD,OO_BENCH_RESULT,
+       OO_BENCH_BATCH,OO_BENCH_POLL,OO_BENCH_COMPLETE,OO_BENCH_UNKNOWN,OO_BENCH_RUN,OO_BENCH_PRESENT_CLOSED };
+enum { OO_WINDOW_BASE_LIFETIME=17,OO_WINDOW_BASE_SLOT,OO_WINDOW_BEGIN,OO_WINDOW_CLOSED,OO_WINDOW_UNSELECTED_SLOT };
