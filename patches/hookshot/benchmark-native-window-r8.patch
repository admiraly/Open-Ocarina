+// Coverage of the recording parts touched by the submit now on the replay thread.
+// 1 new recording, 2 split inside the submission, 3 parallel tail/fallback,
+// 4 resume of the same value after a wait, 5 burst continuation of an open part.
+// Segment command buffers keep part 0 and are not given invented part ids.
+struct OoCoverWatch {
+    int active = 0;
+    uint64_t origin = 0;
+    uint64_t observed_value = 0;
+    uint64_t parts[32]{};
+    uint32_t hooks[32]{};
+    int n = 0;
+};
+OoCoverWatch oo_cover_watch;
+uint64_t oo_cover_observed_value(uint64_t scheduled, uint64_t explicit_observed) {
+    if (explicit_observed != UINT64_MAX) return explicit_observed;
+    return oo_cover_watch.active ? oo_cover_watch.observed_value : scheduled;
+}
+int oo_cover_hook = 0;
+int oo_cover_resume = 0;
+void oo_cover_add(uint64_t part, uint32_t hook) {
+    if (!oo_cover_watch.active || !part) return;
+    for (int i = 0; i < oo_cover_watch.n; ++i) if (oo_cover_watch.parts[i] == part) return;
+    if (oo_cover_watch.n >= 32) {
+        if (const auto* b = oo_bench_bridge()) b->note(OO_BENCH_CAPACITY, oo_cover_watch.origin, part, hook);
+        return;
+    }
+    const int i = oo_cover_watch.n++;
+    oo_cover_watch.parts[i] = part;
+    oo_cover_watch.hooks[i] = hook ? hook : 1u;
+}
+void oo_cover_flush() {
+    if (!oo_cover_watch.active) return;
+    if (const auto* b = oo_bench_bridge()) {
+        for (int i = 0; i < oo_cover_watch.n; ++i)
+            b->note(0, oo_cover_watch.origin, oo_cover_watch.parts[i], 4ull | (uint64_t)oo_cover_watch.hooks[i] << 32);
+    }
+    oo_cover_watch = {};
+}
