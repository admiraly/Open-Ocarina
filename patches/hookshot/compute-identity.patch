+// Open-Ocarina: identity at the actual recording point. No resources are read/copied,
+// no barriers or subgroup policies change, and this is explicitly NOT a replay capture.
+void oo_compute_identity(const Program& p, const NvnState& s, uint32_t x, uint32_t y, uint32_t z, uint64_t indirect) {
+    if (p.stages.empty()) return;
+    uint64_t fingerprint = 14695981039346656037ull;
+    for (const auto& b : s.ubo[5]) oo_identity::mix(fingerprint, b.addr), oo_identity::mix(fingerprint, b.size);
+    for (const auto& b : s.ssbo[5]) oo_identity::mix(fingerprint, b.addr), oo_identity::mix(fingerprint, b.size);
+    for (const auto value : s.tex[5]) oo_identity::mix(fingerprint, value);
+    for (const auto value : s.samp[5]) oo_identity::mix(fingerprint, value);
+    for (const auto value : s.img[5]) oo_identity::mix(fingerprint, value);
+    for (const auto value : p.binding_types) oo_identity::mix(fingerprint, uint64_t(value));
+    oo_identity::mix(fingerprint, s.bind_gen);
+    oo_identity::mix(fingerprint, registrations_generation());
+    oo_identity::mix(fingerprint, sampler_registrations_generation());
+    const auto ci = compute_pipeline_info(p, true);
+    uint32_t required = 0;
+    if (ci.stage.pNext) {
+        const auto* size = static_cast<const VkPipelineShaderStageRequiredSubgroupSizeCreateInfo*>(ci.stage.pNext);
+        if (size->sType == VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO) required = size->requiredSubgroupSize;
+    }
+    oo_identity::emit(p.stages[0].oo_identity, p.key, p.variant, program_cache_stamp(), p.workgroup,
+        x, y, z, indirect, fingerprint, presents_now, required,
+        (ci.stage.flags & VK_PIPELINE_SHADER_STAGE_CREATE_REQUIRE_FULL_SUBGROUPS_BIT) != 0,
+        dev.props.vendorID, dev.props.deviceID, dev.props.driverVersion);
+}
