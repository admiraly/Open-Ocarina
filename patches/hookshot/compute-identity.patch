+inline uint32_t rotate(uint32_t x, unsigned n) { return (x >> n) | (x << (32 - n)); }
+inline std::array<uint8_t, 32> sha256(const uint8_t* bytes, size_t size) {
+    static constexpr uint32_t k[64] = {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+    uint32_t h[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+    const size_t blocks = size / 64 + 1 + (size % 64 >= 56);
+    const uint64_t bits = uint64_t(size) * 8;
+    for (size_t b = 0; b < blocks; ++b) {
+        uint32_t w[64]{};
+        for (unsigned j = 0; j < 64; ++j) {
+            const size_t at = b * 64 + j;
+            uint8_t value = at < size ? bytes[at] : at == size ? 0x80 : 0;
+            if (b == blocks - 1 && j >= 56) value = uint8_t(bits >> (8 * (63 - j)));
+            w[j / 4] |= uint32_t(value) << (24 - 8 * (j % 4));
+        }
+        for (unsigned j = 16; j < 64; ++j) {
+            const uint32_t x = w[j-15], y = w[j-2];
+            w[j] = w[j-16] + (rotate(x,7)^rotate(x,18)^(x>>3)) + w[j-7] + (rotate(y,17)^rotate(y,19)^(y>>10));
+        }
+        uint32_t a=h[0],bb=h[1],c=h[2],d=h[3],e=h[4],f=h[5],g=h[6],hh=h[7];
+        for (unsigned j = 0; j < 64; ++j) {
+            const uint32_t t1=hh+(rotate(e,6)^rotate(e,11)^rotate(e,25))+((e&f)^(~e&g))+k[j]+w[j];
+            const uint32_t t2=(rotate(a,2)^rotate(a,13)^rotate(a,22))+((a&bb)^(a&c)^(bb&c));
+            hh=g;g=f;f=e;e=d+t1;d=c;c=bb;bb=a;a=t1+t2;
+        }
+        h[0]+=a;h[1]+=bb;h[2]+=c;h[3]+=d;h[4]+=e;h[5]+=f;h[6]+=g;h[7]+=hh;
+    }
+    std::array<uint8_t,32> result{};
+    for (unsigned j=0;j<32;++j) result[j]=uint8_t(h[j/4]>>(24-8*(j%4)));
+    return result;
+}
+inline std::string hex(const std::array<uint8_t,32>& bytes) {
+    static constexpr char digits[]="0123456789abcdef";
+    std::string result(64,'0');
+    for (size_t j=0;j<bytes.size();++j) result[2*j]=digits[bytes[j]>>4],result[2*j+1]=digits[bytes[j]&15];
+    return result;
+}
+inline bool hex64(const char* text, uint64_t& result) {
+    if (!text || std::strlen(text)!=16) return false;
+    result=0;
+    for (unsigned j=0;j<16;++j) {
+        const char c=text[j];
+        const int digit=c>='0'&&c<='9'?c-'0':c>='a'&&c<='f'?c-'a'+10:c>='A'&&c<='F'?c-'A'+10:-1;
+        if (digit<0) return false;
+        result=(result<<4)|unsigned(digit);
+    }
+    return true;
+}
+struct Config { bool enabled=false; std::string file; uint64_t key=0,variant=0,limit=256; };
+inline const Config& config() {
+    static const Config value=[] {
+        Config c;
+        const char* file=std::getenv("RX_VK_OO_IDENTITY_FILE");
+        if (!file || !*file) return c;
+        c.file=file;
+        const char* key=std::getenv("RX_VK_OO_IDENTITY_PROGRAM");
+        const char* variant=std::getenv("RX_VK_OO_IDENTITY_VARIANT");
+        if (!hex64(key?key:"cc62764061c44f6a",c.key) || !hex64(variant?variant:"095931037888515a",c.variant)) {
+            std::fprintf(stderr,"Open-Ocarina: identity filter requires full 16-digit hexadecimal key and variant; disabled\n");
+            return c;
+        }
+        c.enabled=true;
+        return c;
+    }();
+    return value;
+}
+inline bool selected(uint64_t key,uint64_t variant) { const auto& c=config();return c.enabled&&c.key==key&&c.variant==variant; }
+struct Identity { std::array<uint8_t,32> digest{}; size_t words=0; bool valid=false; };
+inline void note_stage(uint64_t key,uint64_t variant,Identity& identity,const std::vector<uint32_t>& words) {
+    if (!selected(key,variant) || words.empty()) return;
+    std::vector<uint8_t> canonical(words.size()*4);
+    for (size_t j=0;j<words.size();++j) for (unsigned b=0;b<4;++b) canonical[j*4+b]=uint8_t(words[j]>>(8*b));
+    identity.digest=sha256(canonical.data(),canonical.size());
+    identity.words=words.size();identity.valid=true;
+}
+inline void mix(uint64_t& h,uint64_t value) { for(unsigned j=0;j<8;++j) h=(h^uint8_t(value>>(8*j)))*1099511628211ull; }
+inline void emit(const Identity& identity,uint64_t key,uint64_t variant,uint64_t stamp,
+                 const std::array<uint32_t,3>& workgroup,uint32_t x,uint32_t y,uint32_t z,uint64_t indirect,
+                 uint64_t binding_fingerprint,int64_t observed_present,uint32_t required_size,bool full,
+                 uint32_t vendor,uint32_t device,uint32_t driver) {
+    if (!selected(key,variant)) return;
+    static std::mutex mutex;
+    static uint64_t ordinal=0;
+    static const uint64_t run=uint64_t(std::chrono::system_clock::now().time_since_epoch().count());
+    std::lock_guard lock(mutex);
+    if (ordinal>=config().limit) return;
+    const uint64_t current=ordinal++;
+    FILE* output=std::fopen(config().file.c_str(),"ab");
+    if (!output) { static bool told=false;if(!told)std::perror("Open-Ocarina identity output"),told=true;return; }
+    char grid[96],subgroup[32];
+    if(indirect) std::snprintf(grid,sizeof grid,"null");else std::snprintf(grid,sizeof grid,"[%u,%u,%u]",x,y,z);
+    if(required_size)std::snprintf(subgroup,sizeof subgroup,"%u",required_size);else std::snprintf(subgroup,sizeof subgroup,"null");
+    const std::string digest=identity.valid?"\""+hex(identity.digest)+"\"":"null";
+    const int wrote=std::fprintf(output,
+        "{\"schema\":\"open-ocarina.compute-identity/v1\",\"producer\":{\"stage\":\"identity-only\",\"replay_complete\":false},"
+        "\"event_id\":\"%016llx-%llu\",\"pipeline\":{\"program\":\"%016llx\",\"variant\":\"%016llx\","
+        "\"spirv\":{\"sha256\":%s,\"word_count\":%zu},\"entry_point\":\"main\",\"specialization\":[],\"local_size\":[%u,%u,%u],"
+        "\"cache_stamp\":\"%016llx\",\"subgroup\":{\"required_size\":%s,\"require_full_subgroups\":%s}},"
+        "\"dispatch\":{\"kind\":\"%s\",\"group_count\":%s,\"indirect_guest_address\":\"%016llx\","
+        "\"selected_recording_ordinal\":%llu,\"present_observed\":%lld,\"submission\":null},"
+        "\"binding_state_fingerprint_fnv1a64\":\"%016llx\",\"binding_fingerprint_scope\":\"NVN slots and registration generations only; not resolved Vulkan descriptors or resource contents\","
+        "\"device\":{\"vendor_id\":%u,\"device_id\":%u,\"driver_version\":%u},"
+        "\"coverage\":{\"resource_contents\":false,\"descriptor_contents\":false,\"physical_pointer_reachability\":false,"
+        "\"temporal_state\":false,\"gpu_outputs\":false},"
+        "\"ordinal_scope\":\"selected game compute dispatches at CPU recording point; not queue order\"}\n",
+        (unsigned long long)run,(unsigned long long)current,(unsigned long long)key,(unsigned long long)variant,
+        digest.c_str(),identity.words,workgroup[0],workgroup[1],workgroup[2],(unsigned long long)stamp,subgroup,full?"true":"false",
+        indirect?"indirect":"direct",grid,(unsigned long long)indirect,(unsigned long long)current,(long long)observed_present,
+        (unsigned long long)binding_fingerprint,vendor,device,driver);
+    const int closed=std::fclose(output);
+    if(wrote<0||closed)std::fprintf(stderr,"Open-Ocarina: identity record write failed; this output is incomplete\n");
+}
