+// SPDX-License-Identifier: GPL-3.0-or-later
+// Open-Ocarina opt-in compute identity observations. Not a replay capture.
+#pragma once
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
